{
  "formatVersion": 7,
  "manifest": {
    "id": "kit_datalineage",
    "name": "Data pipelines and lineage",
    "version": "1.0.0",
    "languages": ["en"]
  },
  "settings": {
    "grid": {
      "size": 10,
      "snap": true,
      "visible": true
    },
    "layers": [],
    "numbering": {
      "enabled": false,
      "prefix": "",
      "start": 1
    }
  },
  "classes": {
    "cls_sourcesystem": {
      "id": "cls_sourcesystem",
      "key": "SourceSystem",
      "kind": "node",
      "labels": {
        "en": "Source system"
      },
      "help": {
        "en": "A system where data is first created or captured."
      },
      "attributes": [
        {
          "type": "text",
          "key": "Name",
          "required": true,
          "default": "Source system",
          "id": "att_sourcesystem_name",
          "labels": {
            "en": "Name"
          }
        },
        {
          "type": "text",
          "key": "Description",
          "multiline": true,
          "id": "att_sourcesystem_description",
          "labels": {
            "en": "Description"
          }
        },
        {
          "type": "text",
          "key": "Technology",
          "id": "att_sourcesystem_technology",
          "labels": {
            "en": "Technology"
          }
        },
        {
          "type": "text",
          "key": "Owner",
          "id": "att_sourcesystem_owner",
          "labels": {
            "en": "Owner"
          }
        },
        {
          "type": "choice",
          "key": "Hosting",
          "options": ["On-premises", "Cloud", "Software as a service"],
          "id": "att_sourcesystem_hosting",
          "labels": {
            "en": "Hosting"
          }
        }
      ],
      "shape": "shp_sourcesystem"
    },
    "cls_dataset": {
      "id": "cls_dataset",
      "key": "Dataset",
      "kind": "node",
      "labels": {
        "en": "Dataset"
      },
      "help": {
        "en": "A table or a set of files that jobs write and read. Orphan datasets, which nothing feeds and nothing reads, are reported."
      },
      "attributes": [
        {
          "type": "text",
          "key": "Name",
          "required": true,
          "default": "Dataset",
          "id": "att_dataset_name",
          "labels": {
            "en": "Name"
          }
        },
        {
          "type": "text",
          "key": "Description",
          "multiline": true,
          "id": "att_dataset_description",
          "labels": {
            "en": "Description"
          }
        },
        {
          "type": "text",
          "key": "Format",
          "id": "att_dataset_format",
          "labels": {
            "en": "Format"
          }
        },
        {
          "type": "choice",
          "key": "Refresh",
          "options": [
            "Real time",
            "Hourly",
            "Daily",
            "Weekly",
            "Monthly",
            "On demand"
          ],
          "id": "att_dataset_refresh",
          "labels": {
            "en": "Refresh"
          }
        },
        {
          "type": "choice",
          "key": "Classification",
          "options": ["Public", "Internal", "Confidential", "Restricted"],
          "id": "att_dataset_classification",
          "labels": {
            "en": "Classification"
          }
        },
        {
          "type": "boolean",
          "key": "ContainsPersonalData",
          "id": "att_dataset_containspersonaldata",
          "labels": {
            "en": "Contains personal data"
          }
        },
        {
          "type": "integer",
          "key": "RowCount",
          "min": 0,
          "id": "att_dataset_rowcount",
          "labels": {
            "en": "Row count"
          }
        },
        {
          "type": "choice",
          "key": "Layer",
          "options": ["Raw", "Cleaned", "Curated", "Serving"],
          "id": "att_dataset_layer",
          "labels": {
            "en": "Layer"
          },
          "help": {
            "en": "How far the data has been prepared. The header colour shows it."
          }
        },
        {
          "type": "text",
          "key": "Location",
          "id": "att_dataset_location",
          "labels": {
            "en": "Location"
          },
          "help": {
            "en": "Where it is kept, such as a schema and table name."
          }
        },
        {
          "type": "text",
          "key": "Owner",
          "id": "att_dataset_owner",
          "labels": {
            "en": "Owner"
          }
        },
        {
          "type": "formula",
          "key": "Upstream",
          "formula": "count(incoming('FlowsTo'))",
          "result": "number",
          "id": "att_dataset_upstream",
          "labels": {
            "en": "Upstream"
          },
          "help": {
            "en": "How many sources, jobs or datasets feed it directly."
          }
        },
        {
          "type": "formula",
          "key": "Downstream",
          "formula": "count(outgoing('FlowsTo'))",
          "result": "number",
          "id": "att_dataset_downstream",
          "labels": {
            "en": "Downstream"
          },
          "help": {
            "en": "How many jobs, datasets, reports or applications it feeds directly."
          }
        },
        {
          "type": "formula",
          "key": "StepsFromSource",
          "formula": "count(incoming('FlowsTo')) == 0 ? null : (max(incoming('FlowsTo').StepsFromSource) ?? 0) + 1",
          "result": "number",
          "id": "att_dataset_stepsfromsource",
          "labels": {
            "en": "Steps from source"
          },
          "help": {
            "en": "How many \"Flows to\" steps lie between it and the furthest source system before it. Empty when nothing flows into it."
          }
        }
      ],
      "shape": "shp_dataset",
      "constraints": [
        {
          "id": "k_dataset_orphan",
          "formula": "Upstream + Downstream > 0",
          "message": "= 'Dataset \"' + Name + '\" is an orphan: nothing flows into it and it flows nowhere.'",
          "severity": "warning"
        }
      ]
    },
    "cls_reportordashboard": {
      "id": "cls_reportordashboard",
      "key": "ReportOrDashboard",
      "kind": "node",
      "labels": {
        "en": "Report or dashboard"
      },
      "help": {
        "en": "A report or dashboard that shows data to people."
      },
      "attributes": [
        {
          "type": "text",
          "key": "Name",
          "required": true,
          "default": "Report or dashboard",
          "id": "att_reportordashboard_name",
          "labels": {
            "en": "Name"
          }
        },
        {
          "type": "text",
          "key": "Description",
          "multiline": true,
          "id": "att_reportordashboard_description",
          "labels": {
            "en": "Description"
          }
        },
        {
          "type": "text",
          "key": "Tool",
          "id": "att_reportordashboard_tool",
          "labels": {
            "en": "Tool"
          }
        },
        {
          "type": "text",
          "key": "Audience",
          "id": "att_reportordashboard_audience",
          "labels": {
            "en": "Audience"
          }
        },
        {
          "type": "text",
          "key": "Refresh",
          "id": "att_reportordashboard_refresh",
          "labels": {
            "en": "Refresh"
          }
        },
        {
          "type": "text",
          "key": "Owner",
          "id": "att_reportordashboard_owner",
          "labels": {
            "en": "Owner"
          }
        },
        {
          "type": "formula",
          "key": "Upstream",
          "formula": "count(incoming('FlowsTo'))",
          "result": "number",
          "id": "att_reportordashboard_upstream",
          "labels": {
            "en": "Upstream"
          },
          "help": {
            "en": "How many sources, jobs or datasets feed it directly."
          }
        },
        {
          "type": "formula",
          "key": "StepsFromSource",
          "formula": "count(incoming('FlowsTo')) == 0 ? null : (max(incoming('FlowsTo').StepsFromSource) ?? 0) + 1",
          "result": "number",
          "id": "att_reportordashboard_stepsfromsource",
          "labels": {
            "en": "Steps from source"
          },
          "help": {
            "en": "How many \"Flows to\" steps lie between it and the furthest source system before it. Empty when nothing flows into it."
          }
        }
      ],
      "shape": "shp_reportordashboard",
      "constraints": [
        {
          "id": "k_report_source",
          "formula": "Upstream > 0",
          "message": "= 'Report \"' + Name + '\" has no data flowing into it.'",
          "severity": "warning"
        }
      ]
    },
    "cls_application": {
      "id": "cls_application",
      "key": "Application",
      "kind": "node",
      "labels": {
        "en": "Application"
      },
      "help": {
        "en": "An operational application that receives data from a pipeline, such as a finance system. A target of the lineage."
      },
      "attributes": [
        {
          "type": "text",
          "key": "Name",
          "required": true,
          "default": "Application",
          "id": "att_application_name",
          "labels": {
            "en": "Name"
          }
        },
        {
          "type": "text",
          "key": "Description",
          "multiline": true,
          "id": "att_application_description",
          "labels": {
            "en": "Description"
          }
        },
        {
          "type": "text",
          "key": "Owner",
          "id": "att_application_owner",
          "labels": {
            "en": "Owner"
          }
        },
        {
          "type": "choice",
          "key": "Lifecycle",
          "options": ["Invest", "Tolerate", "Migrate", "Eliminate"],
          "id": "att_application_lifecycle",
          "labels": {
            "en": "Lifecycle"
          }
        },
        {
          "type": "integer",
          "key": "Users",
          "min": 0,
          "id": "att_application_users",
          "labels": {
            "en": "Users"
          }
        },
        {
          "type": "formula",
          "key": "Upstream",
          "formula": "count(incoming('FlowsTo'))",
          "result": "number",
          "id": "att_application_upstream",
          "labels": {
            "en": "Upstream"
          },
          "help": {
            "en": "How many sources, jobs or datasets feed it directly."
          }
        },
        {
          "type": "formula",
          "key": "StepsFromSource",
          "formula": "count(incoming('FlowsTo')) == 0 ? null : (max(incoming('FlowsTo').StepsFromSource) ?? 0) + 1",
          "result": "number",
          "id": "att_application_stepsfromsource",
          "labels": {
            "en": "Steps from source"
          },
          "help": {
            "en": "How many \"Flows to\" steps lie between it and the furthest source system before it. Empty when nothing flows into it."
          }
        }
      ],
      "shape": "shp_application"
    },
    "cls_job": {
      "id": "cls_job",
      "key": "Job",
      "kind": "node",
      "labels": {
        "en": "Job"
      },
      "help": {
        "en": "A step that moves or transforms data: it reads what flows into it and writes what flows out of it. The fill shows how its last run went."
      },
      "attributes": [
        {
          "type": "text",
          "key": "Name",
          "required": true,
          "default": "Job",
          "id": "att_job_name",
          "labels": {
            "en": "Name"
          }
        },
        {
          "type": "text",
          "key": "Description",
          "multiline": true,
          "id": "att_job_description",
          "labels": {
            "en": "Description"
          }
        },
        {
          "type": "choice",
          "key": "Kind",
          "options": ["Ingestion", "Transformation", "Export", "Quality check"],
          "id": "att_job_kind",
          "labels": {
            "en": "Kind"
          }
        },
        {
          "type": "text",
          "key": "Tool",
          "id": "att_job_tool",
          "labels": {
            "en": "Tool"
          },
          "help": {
            "en": "The tool or language it runs in, as free text."
          }
        },
        {
          "type": "text",
          "key": "Owner",
          "id": "att_job_owner",
          "labels": {
            "en": "Owner"
          }
        },
        {
          "type": "text",
          "key": "Logic",
          "multiline": true,
          "id": "att_job_logic",
          "labels": {
            "en": "Logic"
          },
          "help": {
            "en": "What it does to the data, in a few lines or as code."
          }
        },
        {
          "type": "choice",
          "key": "LastRunStatus",
          "options": ["Succeeded", "Failed", "Running", "Not run yet"],
          "id": "att_job_lastrunstatus",
          "labels": {
            "en": "Last run status"
          }
        },
        {
          "type": "number",
          "key": "AverageMinutes",
          "unit": "min",
          "min": 0,
          "id": "att_job_averageminutes",
          "labels": {
            "en": "Average run time"
          }
        },
        {
          "type": "formula",
          "key": "ScheduleText",
          "formula": "count(incoming('Triggers')) > 0 ? join(incoming('Triggers').Name, ', ') : (count(outgoing('RunsAfter')) > 0 ? 'After ' + join(outgoing('RunsAfter').Name, ', ') : null)",
          "result": "text",
          "id": "att_job_scheduletext",
          "labels": {
            "en": "Runs"
          },
          "help": {
            "en": "The schedules that start it, or the jobs it runs after."
          }
        },
        {
          "type": "formula",
          "key": "Upstream",
          "formula": "count(incoming('FlowsTo'))",
          "result": "number",
          "id": "att_job_upstream",
          "labels": {
            "en": "Upstream"
          },
          "help": {
            "en": "How many sources, jobs or datasets feed it directly."
          }
        },
        {
          "type": "formula",
          "key": "Downstream",
          "formula": "count(outgoing('FlowsTo'))",
          "result": "number",
          "id": "att_job_downstream",
          "labels": {
            "en": "Downstream"
          },
          "help": {
            "en": "How many jobs, datasets, reports or applications it feeds directly."
          }
        },
        {
          "type": "formula",
          "key": "StepsFromSource",
          "formula": "count(incoming('FlowsTo')) == 0 ? null : (max(incoming('FlowsTo').StepsFromSource) ?? 0) + 1",
          "result": "number",
          "id": "att_job_stepsfromsource",
          "labels": {
            "en": "Steps from source"
          },
          "help": {
            "en": "How many \"Flows to\" steps lie between it and the furthest source system before it. Empty when nothing flows into it."
          }
        }
      ],
      "constraints": [
        {
          "id": "k_job_schedule",
          "formula": "count(incoming('Triggers')) > 0 || count(outgoing('RunsAfter')) > 0",
          "message": "= 'Job \"' + Name + '\" has no schedule: connect a schedule with \"Triggers\", or the job it runs after with \"Runs after\".'",
          "severity": "warning"
        },
        {
          "id": "k_job_flows",
          "formula": "Upstream > 0 && Downstream > 0",
          "message": "= 'Job \"' + Name + '\" needs something that flows into it and something it flows to.'",
          "severity": "warning"
        }
      ],
      "shape": "shp_job"
    },
    "cls_schedule": {
      "id": "cls_schedule",
      "key": "Schedule",
      "kind": "node",
      "labels": {
        "en": "Schedule"
      },
      "help": {
        "en": "When jobs start: at fixed times, on an event or by hand, and in which orchestration tool (free text)."
      },
      "attributes": [
        {
          "type": "text",
          "key": "Name",
          "required": true,
          "default": "Schedule",
          "id": "att_schedule_name",
          "labels": {
            "en": "Name"
          }
        },
        {
          "type": "text",
          "key": "Description",
          "multiline": true,
          "id": "att_schedule_description",
          "labels": {
            "en": "Description"
          }
        },
        {
          "type": "choice",
          "key": "Frequency",
          "options": [
            "Every 15 minutes",
            "Hourly",
            "Daily",
            "Weekly",
            "Monthly",
            "On an event",
            "By hand"
          ],
          "id": "att_schedule_frequency",
          "labels": {
            "en": "Frequency"
          }
        },
        {
          "type": "text",
          "key": "Cron",
          "id": "att_schedule_cron",
          "labels": {
            "en": "Cron expression"
          },
          "help": {
            "en": "The exact times in cron form, such as \"0 2 * * *\" for 02:00 every day."
          }
        },
        {
          "type": "text",
          "key": "Timezone",
          "id": "att_schedule_timezone",
          "labels": {
            "en": "Timezone"
          }
        },
        {
          "type": "text",
          "key": "Orchestrator",
          "id": "att_schedule_orchestrator",
          "labels": {
            "en": "Orchestrator"
          },
          "help": {
            "en": "The tool that starts the jobs, as free text."
          }
        },
        {
          "type": "formula",
          "key": "Jobs",
          "formula": "count(outgoing('Triggers'))",
          "result": "number",
          "id": "att_schedule_jobs",
          "labels": {
            "en": "Jobs"
          },
          "help": {
            "en": "How many jobs it starts."
          }
        }
      ],
      "shape": "shp_schedule"
    },
    "cls_field": {
      "id": "cls_field",
      "key": "Field",
      "kind": "node",
      "labels": {
        "en": "Field"
      },
      "help": {
        "en": "One column of a dataset or one value on a report. Map fields to each other for lineage down to the field."
      },
      "attributes": [
        {
          "type": "text",
          "key": "Name",
          "required": true,
          "default": "Field",
          "id": "att_field_name",
          "labels": {
            "en": "Name"
          }
        },
        {
          "type": "text",
          "key": "DataType",
          "id": "att_field_datatype",
          "labels": {
            "en": "Data type"
          }
        },
        {
          "type": "text",
          "key": "Description",
          "multiline": true,
          "id": "att_field_description",
          "labels": {
            "en": "Description"
          }
        },
        {
          "type": "formula",
          "key": "In",
          "formula": "join(outgoing('PartOf').Name, ', ')",
          "result": "text",
          "id": "att_field_in",
          "labels": {
            "en": "In"
          },
          "help": {
            "en": "The dataset or report it belongs to."
          }
        },
        {
          "type": "formula",
          "key": "SourceFields",
          "formula": "count(incoming('MapsTo'))",
          "result": "number",
          "id": "att_field_sourcefields",
          "labels": {
            "en": "Source fields"
          },
          "help": {
            "en": "How many fields it is made from."
          }
        },
        {
          "type": "formula",
          "key": "TargetFields",
          "formula": "count(outgoing('MapsTo'))",
          "result": "number",
          "id": "att_field_targetfields",
          "labels": {
            "en": "Target fields"
          },
          "help": {
            "en": "How many fields are made from it."
          }
        }
      ],
      "constraints": [
        {
          "id": "k_field_partof",
          "formula": "count(outgoing('PartOf')) > 0",
          "message": "= 'Field \"' + Name + '\" belongs to no dataset or report: connect it with \"Part of\".'",
          "severity": "warning"
        }
      ],
      "shape": "shp_field"
    }
  },
  "relations": {
    "rel_flowsto": {
      "id": "rel_flowsto",
      "key": "FlowsTo",
      "labels": {
        "en": "Flows to"
      },
      "help": {
        "en": "Data moves from one place to the next."
      },
      "from": ["cls_sourcesystem", "cls_dataset", "cls_job"],
      "to": [
        "cls_dataset",
        "cls_reportordashboard",
        "cls_job",
        "cls_application"
      ],
      "attributes": [
        {
          "type": "text",
          "key": "Frequency",
          "id": "att_flowsto_frequency",
          "labels": {
            "en": "Frequency"
          }
        },
        {
          "type": "text",
          "key": "Format",
          "id": "att_flowsto_format",
          "labels": {
            "en": "Format"
          }
        },
        {
          "type": "boolean",
          "key": "ContainsPersonalData",
          "id": "att_flowsto_containspersonaldata",
          "labels": {
            "en": "Contains personal data"
          }
        }
      ],
      "shape": "shp_rel_flowsto"
    },
    "rel_triggers": {
      "id": "rel_triggers",
      "key": "Triggers",
      "labels": {
        "en": "Triggers"
      },
      "help": {
        "en": "The schedule starts the job."
      },
      "from": ["cls_schedule"],
      "to": ["cls_job"],
      "attributes": [],
      "shape": "shp_rel_triggers"
    },
    "rel_runsafter": {
      "id": "rel_runsafter",
      "key": "RunsAfter",
      "labels": {
        "en": "Runs after"
      },
      "help": {
        "en": "The job starts when the other job has finished."
      },
      "from": ["cls_job"],
      "to": ["cls_job"],
      "attributes": [],
      "shape": "shp_rel_runsafter"
    },
    "rel_partof": {
      "id": "rel_partof",
      "key": "PartOf",
      "labels": {
        "en": "Part of"
      },
      "help": {
        "en": "The field is a column of the dataset or a value on the report."
      },
      "from": ["cls_field"],
      "to": ["cls_dataset", "cls_reportordashboard"],
      "attributes": [],
      "shape": "shp_rel_partof"
    },
    "rel_mapsto": {
      "id": "rel_mapsto",
      "key": "MapsTo",
      "labels": {
        "en": "Maps to"
      },
      "help": {
        "en": "The value of the target field is made from this field: lineage at the level of fields."
      },
      "from": ["cls_field"],
      "to": ["cls_field"],
      "attributes": [
        {
          "type": "text",
          "key": "Transformation",
          "id": "att_mapsto_transformation",
          "labels": {
            "en": "Transformation"
          },
          "help": {
            "en": "How the value is made, such as \"amount_cents / 100\"."
          }
        }
      ],
      "shape": "shp_rel_mapsto"
    }
  },
  "modelTypes": {
    "mt_lineage": {
      "id": "mt_lineage",
      "key": "Lineage",
      "labels": {
        "en": "Data pipelines and lineage"
      },
      "classes": [
        "cls_sourcesystem",
        "cls_dataset",
        "cls_reportordashboard",
        "cls_application",
        "cls_job",
        "cls_schedule",
        "cls_field"
      ],
      "relations": [
        "rel_flowsto",
        "rel_triggers",
        "rel_runsafter",
        "rel_partof",
        "rel_mapsto"
      ],
      "views": [
        {
          "id": "vw_pipelines",
          "key": "Pipelines",
          "labels": {
            "en": "Pipelines"
          },
          "classes": [
            "cls_sourcesystem",
            "cls_job",
            "cls_schedule",
            "cls_dataset",
            "cls_reportordashboard",
            "cls_application"
          ],
          "relations": ["rel_flowsto", "rel_triggers", "rel_runsafter"]
        },
        {
          "id": "vw_fieldlineage",
          "key": "FieldLineage",

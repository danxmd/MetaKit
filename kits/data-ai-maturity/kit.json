    "rule_actiondone": {
      "id": "rule_actiondone",
      "label": "Ask to score again when an action is done",
      "when": {
        "event": "attribute.changed",
        "class": "cls_action",
        "attribute": "Status"
      },
      "if": "= Status == 'Done'",
      "then": [
        {
          "action": "message",
          "kind": "info",
          "text": "= 'Action \"' + Name + '\" is done. Score these capabilities again: ' + join(outgoing('Improves').Name, ', ') + '.'"
        }

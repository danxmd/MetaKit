{
  "formatVersion": 7,
  "manifest": {
    "id": "kit_kpitree",
    "name": "KPI and metric tree",
    "version": "1.0.0",
    "languages": ["en"]
  },
  "settings": {
    "grid": {
      "size": 10,
      "snap": true,
      "visible": true
    },
    "layers": [],
    "numbering": {
      "enabled": false,
      "prefix": "",
      "start": 1
    }
  },
  "classes": {
    "cls_goal": {
      "id": "cls_goal",
      "key": "Goal",
      "kind": "node",
      "labels": {
        "en": "Goal"
      },
      "help": {
        "en": "Something the organisation wants to achieve, with a time horizon and a way to measure it."
      },
      "attributes": [
        {
          "type": "text",
          "key": "Name",
          "required": true,
          "default": "Goal",
          "id": "att_goal_name",
          "labels": {
            "en": "Name"
          }
        },
        {
          "type": "text",
          "key": "Description",
          "multiline": true,
          "id": "att_goal_description",
          "labels": {
            "en": "Description"
          }
        },
        {
          "type": "choice",
          "key": "Horizon",
          "options": ["Short term", "Medium term", "Long term"],
          "id": "att_goal_horizon",
          "labels": {
            "en": "Horizon"
          }
        },
        {
          "type": "text",
          "key": "Measure",
          "id": "att_goal_measure",
          "labels": {
            "en": "Measure"
          }
        }
      ],
      "shape": "shp_goal"
    },
    "cls_kpi": {
      "id": "cls_kpi",
      "key": "KPI",
      "kind": "node",
      "labels": {
        "en": "KPI"
      },
      "help": {
        "en": "Anything measured against a target. Use one of its three kinds: outcome KPI, driver metric or operational metric."
      },
      "attributes": [
        {
          "type": "text",
          "key": "Name",
          "required": true,
          "default": "KPI",
          "id": "att_kpi_name",
          "labels": {
            "en": "Name"
          }
        },
        {
          "type": "text",
          "key": "Description",
          "multiline": true,
          "id": "att_kpi_description",
          "labels": {
            "en": "Description"
          }
        },
        {
          "type": "text",
          "key": "Unit",
          "id": "att_kpi_unit",
          "labels": {
            "en": "Unit"
          }
        },
        {
          "type": "number",
          "key": "Target",
          "id": "att_kpi_target",
          "labels": {
            "en": "Target"
          },
          "help": {
            "en": "A fixed target. Leave it empty to derive the target from the baseline and the planned change."
          }
        },
        {
          "type": "number",
          "key": "Current",
          "id": "att_kpi_current",
          "labels": {
            "en": "Current"
          }
        },
        {
          "type": "choice",
          "key": "Direction",
          "options": ["Higher is better", "Lower is better"],
          "id": "att_kpi_direction",
          "labels": {
            "en": "Direction"
          }
        },
        {
          "type": "formula",
          "key": "OnTrack",
          "formula": "Current == null || TargetValue == null ? null : (Direction == 'Lower is better' ? Current <= TargetValue : Current >= TargetValue)",
          "result": "boolean",
          "id": "att_kpi_ontrack",
          "labels": {
            "en": "On track"
          },
          "help": {
            "en": "Yes when the current value has reached the target in the given direction."
          }
        },
        {
          "type": "text",
          "key": "Owner",
          "id": "att_kpi_owner",
          "labels": {
            "en": "Owner"
          }
        },
        {
          "type": "choice",
          "key": "Frequency",
          "options": ["Daily", "Weekly", "Monthly", "Quarterly", "Yearly"],
          "id": "att_kpi_frequency",
          "labels": {
            "en": "Frequency"
          }
        },
        {
          "type": "number",
          "key": "Baseline",
          "id": "att_kpi_baseline",
          "labels": {
            "en": "Baseline"
          },
          "help": {
            "en": "The value when the target was set."
          }
        },
        {
          "type": "number",
          "key": "TargetChange",
          "unit": "%",
          "id": "att_kpi_targetchange",
          "labels": {
            "en": "Planned change"
          },
          "help": {
            "en": "The planned change against the baseline, such as 15 for 15% more."
          }
        },
        {
          "type": "formula",
          "key": "TargetValue",
          "formula": "Target ?? (Baseline == null || TargetChange == null ? null : round(Baseline * (1 + TargetChange / 100), 4))",
          "result": "number",
          "id": "att_kpi_targetvalue",
          "labels": {
            "en": "Target used"
          },
          "help": {
            "en": "The fixed target, or the baseline with the planned change applied."
          }
        },
        {
          "type": "formula",
          "key": "Attainment",
          "formula": "IFERROR(Current == null || TargetValue == null ? null : round((Direction == 'Lower is better' ? TargetValue / Current : Current / TargetValue) * 100, 1), null)",
          "result": "number",
          "id": "att_kpi_attainment",
          "labels": {
            "en": "Attainment (%)"
          },
          "help": {
            "en": "How much of the target is reached, in percent. Above 100 is better than the target."
          }
        },
        {
          "type": "formula",
          "key": "Reading",
          "formula": "(Current == null ? '-' : text(Current)) + (Unit ? ' ' + Unit : '') + ', target ' + (TargetValue == null ? '-' : text(TargetValue))",
          "result": "text",
          "id": "att_kpi_reading",
          "labels": {
            "en": "Current and target"
          },
          "help": {
            "en": "The current value and the target, shown on the diagram."
          }
        },
        {
          "type": "formula",
          "key": "Drivers",
          "formula": "count(incoming('Drives'))",
          "result": "number",
          "id": "att_kpi_drivers",
          "labels": {
            "en": "Drivers"
          },
          "help": {
            "en": "How many metrics drive this one."
          }
        }
      ],
      "abstract": true,
      "constraints": [
        {
          "id": "k_kpi_target",
          "formula": "TargetValue != null",
          "message": "= '\"' + Name + '\" has no target: give it a target, or a baseline and a planned change.'",
          "severity": "warning"
        }
      ]
    },
    "cls_outcomekpi": {
      "id": "cls_outcomekpi",
      "key": "OutcomeKPI",
      "kind": "node",
      "labels": {
        "en": "Outcome KPI"
      },
      "help": {
        "en": "A result the organisation is judged by, such as revenue or customer satisfaction."
      },
      "attributes": [],
      "extends": "cls_kpi",
      "constraints": [
        {
          "id": "k_outcome_drivers",
          "formula": "Drivers > 0",
          "message": "= 'Outcome KPI \"' + Name + '\" has no driver metrics yet.'",
          "severity": "warning"
        }
      ],
      "shape": "shp_outcomekpi"
    },
    "cls_drivermetric": {
      "id": "cls_drivermetric",
      "key": "DriverMetric",
      "kind": "node",
      "labels": {
        "en": "Driver metric"
      },
      "help": {
        "en": "A metric that explains an outcome KPI, such as conversion rate for revenue."
      },
      "attributes": [],
      "extends": "cls_kpi",
      "constraints": [
        {
          "id": "k_drivermetric_drives",
          "formula": "count(outgoing('Drives')) > 0",
          "message": "= 'Driver metric \"' + Name + '\" drives nothing: connect it to the metric or KPI it explains with \"Drives\".'",
          "severity": "warning"
        }
      ],
      "shape": "shp_drivermetric"
    },
    "cls_operationalmetric": {
      "id": "cls_operationalmetric",
      "key": "OperationalMetric",
      "kind": "node",
      "labels": {
        "en": "Operational metric"
      },
      "help": {
        "en": "A metric of day-to-day work that a team can change directly, such as page load time."
      },
      "attributes": [],
      "extends": "cls_kpi",
      "constraints": [
        {
          "id": "k_operationalmetric_drives",
          "formula": "count(outgoing('Drives')) > 0",
          "message": "= 'Operational metric \"' + Name + '\" drives nothing: connect it to the metric or KPI it explains with \"Drives\".'",
          "severity": "warning"
        }
      ],
      "shape": "shp_operationalmetric"
    }
  },
  "relations": {
    "rel_measures": {
      "id": "rel_measures",
      "key": "Measures",
      "labels": {
        "en": "Measures"
      },
      "help": {
        "en": "A KPI measures how well something is doing."
      },
      "from": ["cls_kpi"],
      "to": ["cls_goal"],
      "attributes": [],
      "shape": "shp_rel_measures"
    },
    "rel_drives": {
      "id": "rel_drives",
      "key": "Drives",
      "labels": {
        "en": "Drives"
      },
      "help": {
        "en": "The metric explains part of the one it points to."
      },
      "from": ["cls_drivermetric", "cls_operationalmetric"],
      "to": ["cls_outcomekpi", "cls_drivermetric"],
      "attributes": [
        {
          "type": "number",
          "key": "Weight",
          "unit": "%",
          "min": 0,
          "max": 100,
          "id": "att_drives_weight",
          "labels": {
            "en": "Weight"
          },
          "help": {
            "en": "How much of the target metric it explains, as a share."
          }
        },
        {
          "type": "choice",
          "key": "Effect",
          "options": ["Raises", "Lowers"],
          "id": "att_drives_effect",
          "labels": {
            "en": "Effect"
          },
          "help": {
            "en": "Whether a higher value of this metric raises or lowers the one it drives."
          }
        }
      ],
      "shape": "shp_rel_drives"
    }
  },
  "modelTypes": {
    "mt_metrictree": {
      "id": "mt_metrictree",
      "key": "MetricTree",
      "labels": {
        "en": "Metric tree"
      },
      "classes": [
        "cls_goal",
        "cls_outcomekpi",
        "cls_drivermetric",
        "cls_operationalmetric"
      ],
      "relations": ["rel_measures", "rel_drives"],
      "views": [
        {
          "id": "vw_outcomes",
          "key": "Outcomes",
          "labels": {
            "en": "Outcomes"
          },
          "classes": ["cls_goal", "cls_outcomekpi", "cls_drivermetric"],
          "relations": ["rel_measures", "rel_drives"]
        }
      ],
      "cardinalities": [
        {
          "kind": "count",
          "class": "cls_outcomekpi",
          "min": 1
        }
      ],
      "attributes": [
        {
          "type": "text",
          "key": "Title",
          "required": true,
          "maxLength": 100,
          "id": "att_mtmetrictree_title",
          "labels": {
            "en": "Title"
          }
        },
        {
          "type": "text",
          "key": "Period",
          "id": "att_mtmetrictree_period",
          "labels": {
            "en": "Reporting period"
          }
        },
        {
          "type": "text",
          "key": "Owner",
          "id": "att_mtmetrictree_owner",
          "labels": {
            "en": "Owner"
          }
        }
      ],
      "help": {
        "en": "Goals measured by outcome KPIs, explained by driver metrics and operational metrics."
      }
    }
  },

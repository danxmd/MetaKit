{
  "formatVersion": 7,
  "manifest": {
    "id": "kit_mindmap",
    "name": "Mind map and concept map",
    "version": "1.0.0",
    "languages": ["en"]
  },
  "settings": {
    "grid": {
      "size": 10,
      "snap": true,
      "visible": true
    },
    "layers": [],
    "numbering": {
      "enabled": false,
      "prefix": "",
      "start": 1
    }
  },
  "classes": {
    "cls_note": {
      "id": "cls_note",
      "key": "Note",
      "kind": "node",
      "labels": {
        "en": "Note"
      },
      "help": {
        "en": "A free note on a diagram, for comments and explanations."
      },
      "attributes": [
        {
          "type": "text",
          "key": "Name",
          "required": true,
          "default": "Note",
          "id": "att_note_name",
          "labels": {
            "en": "Name"
          }
        },
        {
          "type": "text",
          "key": "Description",
          "multiline": true,
          "id": "att_note_description",
          "labels": {
            "en": "Description"
          }
        },
        {
          "type": "text",
          "key": "Text",
          "multiline": true,
          "id": "att_note_text",
          "labels": {
            "en": "Text"
          }
        }
      ],
      "shape": "shp_note"
    },
    "cls_centraltopic": {
      "id": "cls_centraltopic",
      "key": "CentralTopic",
      "kind": "node",
      "labels": {
        "en": "Central topic"
      },
      "help": {
        "en": "The subject of the mind map, in the middle. Everything else branches from it."
      },
      "attributes": [
        {
          "type": "text",
          "key": "Name",
          "required": true,
          "default": "Central topic",
          "id": "att_centraltopic_name",
          "labels": {
            "en": "Name"
          }
        },
        {
          "type": "text",
          "key": "Description",
          "multiline": true,
          "id": "att_centraltopic_description",
          "labels": {
            "en": "Description"
          }
        },
        {
          "type": "formula",
          "key": "Branches",
          "formula": "count(outgoing('BranchesTo'))",
          "result": "number",
          "id": "att_centraltopic_branches",
          "labels": {
            "en": "Branches"
          },
          "help": {
            "en": "How many topics branch from it."
          }
        }
      ],
      "shape": "shp_centraltopic"
    },
    "cls_topic": {
      "id": "cls_topic",
      "key": "Topic",
      "kind": "node",
      "labels": {
        "en": "Topic"
      },
      "help": {
        "en": "A main branch of the map. Its colour is passed on to the topics and ideas that hang from it."
      },
      "attributes": [
        {
          "type": "text",
          "key": "Name",
          "required": true,
          "default": "Topic",
          "id": "att_topic_name",
          "labels": {
            "en": "Name"
          }
        },
        {
          "type": "choice",
          "key": "Colour",
          "options": ["Blue", "Green", "Orange", "Purple", "Red", "Teal"],
          "id": "att_topic_colour",
          "labels": {
            "en": "Colour"
          },
          "help": {
            "en": "The colour of the branch. Leave it empty on a sub-topic to take the colour of the topic above."
          }
        },
        {
          "type": "text",
          "key": "Description",
          "multiline": true,
          "id": "att_topic_description",
          "labels": {
            "en": "Description"
          }
        },
        {
          "type": "formula",
          "key": "BranchColour",
          "formula": "Colour ?? IFERROR(incoming('BranchesTo')[0].BranchColour, null)",
          "result": "text",
          "id": "att_topic_branchcolour",
          "labels": {
            "en": "Branch colour"
          },
          "help": {
            "en": "Its own colour, or the colour of the topic it hangs from."
          }
        },
        {
          "type": "formula",
          "key": "Ideas",
          "formula": "count(outgoing('BranchesTo'))",
          "result": "number",
          "id": "att_topic_ideas",
          "labels": {
            "en": "Ideas"
          },
          "help": {
            "en": "How many topics and ideas hang from it."
          }
        }
      ],
      "constraints": [
        {
          "id": "k_topic_attached",
          "formula": "count(incoming('BranchesTo')) > 0",
          "message": "= 'Topic \"' + Name + '\" is not attached to the map: connect it to its topic with \"Branch\".'",
          "severity": "warning"
        }
      ],
      "shape": "shp_topic"
    },
    "cls_idea": {
      "id": "cls_idea",
      "key": "Idea",
      "kind": "node",
      "labels": {
        "en": "Idea"
      },
      "help": {
        "en": "A thought on a branch. It takes the colour of its topic."
      },
      "attributes": [
        {
          "type": "text",
          "key": "Name",
          "required": true,
          "default": "Idea",
          "id": "att_idea_name",
          "labels": {
            "en": "Name"
          }
        },
        {
          "type": "text",
          "key": "Description",
          "multiline": true,
          "id": "att_idea_description",
          "labels": {
            "en": "Description"
          }
        },
        {
          "type": "formula",
          "key": "BranchColour",
          "formula": "IFERROR(incoming('BranchesTo')[0].BranchColour, null)",
          "result": "text",
          "id": "att_idea_branchcolour",
          "labels": {
            "en": "Branch colour"
          },
          "help": {
            "en": "The colour of the topic it hangs from."
          }
        }
      ],
      "constraints": [
        {
          "id": "k_idea_attached",
          "formula": "count(incoming('BranchesTo')) > 0",
          "message": "= 'Idea \"' + Name + '\" is not attached to the map: connect it to its topic with \"Branch\".'",
          "severity": "warning"
        }
      ],
      "shape": "shp_idea"
    },
    "cls_concept": {
      "id": "cls_concept",
      "key": "Concept",
      "kind": "node",
      "labels": {
        "en": "Concept"
      },
      "help": {
        "en": "An idea in a concept map, linked to other concepts by labelled links."
      },
      "attributes": [
        {
          "type": "text",
          "key": "Name",
          "required": true,
          "default": "Concept",
          "id": "att_concept_name",
          "labels": {
            "en": "Name"
          }
        },
        {
          "type": "choice",
          "key": "Colour",
          "options": ["Blue", "Green", "Orange", "Purple", "Red", "Teal"],
          "id": "att_concept_colour",
          "labels": {
            "en": "Colour"
          }
        },
        {
          "type": "text",
          "key": "Description",
          "multiline": true,
          "id": "att_concept_description",
          "labels": {
            "en": "Description"
          }
        }
      ],
      "constraints": [
        {
          "id": "k_concept_linked",
          "formula": "count(outgoing('LinksTo')) + count(incoming('LinksTo')) > 0",
          "message": "= 'Concept \"' + Name + '\" is not linked to any other.'",
          "severity": "warning"
        }
      ],
      "shape": "shp_concept"
    }
  },
  "relations": {
    "rel_branchesto": {
      "id": "rel_branchesto",
      "key": "BranchesTo",
      "labels": {
        "en": "Branch"
      },
      "help": {
        "en": "The topic or idea hangs from the central topic or topic it starts at."
      },
      "from": ["cls_centraltopic", "cls_topic"],
      "to": ["cls_topic", "cls_idea"],
      "attributes": [],
      "shape": "shp_rel_branchesto"
    },
    "rel_linksto": {
      "id": "rel_linksto",
      "key": "LinksTo",
      "labels": {
        "en": "Link"
      },
      "help": {
        "en": "A labelled link that reads as a sentence from one end to the other, such as \"Budget limits Venue\"."
      },
      "from": ["cls_centraltopic", "cls_topic", "cls_idea", "cls_concept"],
      "to": ["cls_centraltopic", "cls_topic", "cls_idea", "cls_concept"],
      "attributes": [
        {
          "type": "text",
          "key": "Label",
          "id": "att_linksto_label",
          "labels": {
            "en": "Label"
          },
          "help": {
            "en": "The words on the link, such as \"limits\"."
          }
        }
      ],
      "shape": "shp_rel_linksto",
      "constraints": [
        {
          "id": "k_link_label",
          "formula": "!isEmpty(Label)",
          "message": "= 'The link from \"' + from.Name + '\" to \"' + to.Name + '\" has no label: say how they are related.'",
          "severity": "warning"
        }
      ]
    },
    "rel_annotates": {
      "id": "rel_annotates",
      "key": "Annotates",
      "labels": {
        "en": "Annotates"
      },
      "help": {
        "en": "The note explains the object it points to."
      },
      "from": ["cls_note"],
      "to": ["cls_centraltopic", "cls_topic", "cls_idea", "cls_concept"],
      "attributes": [],
      "shape": "shp_rel_annotates"
    }
  },
  "modelTypes": {
    "mt_mindmap": {
      "id": "mt_mindmap",
      "key": "MindMap",
      "labels": {
        "en": "Mind map"
      },
      "classes": ["cls_centraltopic", "cls_topic", "cls_idea", "cls_note"],
      "relations": ["rel_branchesto", "rel_linksto", "rel_annotates"],
      "views": [],
      "cardinalities": [
        {
          "kind": "count",
          "class": "cls_centraltopic",
          "min": 1,
          "max": 1
        }
      ],
      "attributes": [
        {
          "type": "text",
          "key": "Title",
          "required": true,
          "maxLength": 100,
          "id": "att_mtmindmap_title",
          "labels": {
            "en": "Title"
          }
        },
        {
          "type": "text",
          "key": "Author",
          "id": "att_mtmindmap_author",
          "labels": {
            "en": "Author"
          }
        },
        {
          "type": "formula",
          "key": "Topics",
          "formula": "count(objects('Topic'))",
          "result": "number",
          "id": "att_mtmindmap_topics",
          "labels": {
            "en": "Topics"
          },
          "help": {
            "en": "How many topics the map has."
          }
        },
        {
          "type": "formula",
          "key": "Ideas",
          "formula": "count(objects('Idea'))",
          "result": "number",
          "id": "att_mtmindmap_ideas",
          "labels": {
            "en": "Ideas"
          },
          "help": {
            "en": "How many ideas the map has."
          }
        }
      ],
      "help": {
        "en": "One central topic with topics and ideas branching from it, coloured by branch."
      }
    },
    "mt_conceptmap": {
      "id": "mt_conceptmap",
      "key": "ConceptMap",
      "labels": {
        "en": "Concept map"
      },
      "classes": ["cls_concept", "cls_note"],
      "relations": ["rel_linksto", "rel_annotates"],
      "views": [],
      "cardinalities": [],
      "attributes": [
        {
          "type": "text",
          "key": "Title",
          "required": true,
          "maxLength": 100,
          "id": "att_mtconceptmap_title",
          "labels": {
            "en": "Title"
          }
        },
        {
          "type": "text",
          "key": "FocusQuestion",
          "id": "att_mtconceptmap_focusquestion",
          "labels": {
            "en": "Focus question"
          },
          "help": {
            "en": "The question the map answers."
          }
        }
      ],
      "help": {
        "en": "Concepts joined by labelled links that read as sentences."
      }
    }
  },
  "shapes": {
    "shp_note": {
      "id": "shp_note",
      "name": "Note look",
      "kind": "node",
      "size": {
        "width": 120,
        "height": 90,
        "resizable": true,
        "minWidth": 40,
        "minHeight": 28
      },
      "outline": {
        "type": "polygon",
        "points": [
          [0, 0],
          ["100% - 18", 0],
          ["100%", 18],
          ["100%", "100%"],
          [0, "100%"]
        ]
      },
      "parts": [
        {
          "type": "polygon",
          "points": [
            [0, 0],
            ["100% - 18", 0],
            ["100%", 18],
            ["100%", "100%"],
            [0, "100%"]
          ],
          "fill": "#ffec99",
          "stroke": "#f2c200",
          "strokeWidth": 1.5
        },
        {
          "type": "polygon",
          "points": [
            ["100% - 18", 0],
            ["100% - 18", 18],
            ["100%", 18]
          ],
          "fill": "#00000022",
          "stroke": "#f2c200",
          "strokeWidth": 1
        },
        {
          "type": "text",
          "x": 8,
          "y": 20,
          "width": "100% - 16",
          "height": "100% - 26",
          "text": "= Name",
          "wrap": true,
          "fit": "shrink",
          "align": "center",
          "valign": "middle",
          "fill": "#1b1f27",
          "font": {
            "weight": 600
          }
        }
      ],
      "look": {
        "base": "document",
        "fill": "#ffec99",
        "border": "#f2c200",
        "borderWidth": 1.5,
        "borderStyle": "solid",
        "title": {
          "attribute": "Name",
          "bold": true
        },
        "size": {
          "width": 120,
          "height": 90,
          "resizable": true
        }
      }
    },
    "shp_centraltopic": {
      "id": "shp_centraltopic",
      "name": "CentralTopic look",
      "kind": "node",
      "size": {
        "width": 220,
        "height": 110,
        "resizable": true,
        "minWidth": 40,
        "minHeight": 28
      },
      "outline": "ellipse",
      "parts": [
        {
          "type": "ellipse",
          "x": 0,
          "y": 0,
          "width": "100%",
          "height": "100%",
          "fill": "#ffec99",
          "stroke": "#f08c00",
          "strokeWidth": 2.5
        },
        {
          "type": "text",
          "x": "15%",
          "y": "15%",
          "width": "70%",
          "height": "70%",
          "text": "= Name",
          "wrap": true,
          "fit": "shrink",
          "align": "center",
          "valign": "middle",
          "fill": "#1b1f27",
          "font": {
            "weight": 600
          }
        }
      ],
      "look": {
        "base": "circle",
        "fill": "#ffec99",
        "border": "#f08c00",
        "borderWidth": 2.5,
        "borderStyle": "solid",
        "title": {
          "attribute": "Name",
          "bold": true
        },
        "size": {
          "width": 220,
          "height": 110,
          "resizable": true
        }
      }
    },
    "shp_topic": {
      "id": "shp_topic",
      "name": "Topic look",
      "kind": "node",
      "size": {
        "width": 160,
        "height": 50,
        "resizable": true,
        "minWidth": 40,
        "minHeight": 28
      },
      "outline": "rect",
      "parts": [
        {
          "type": "rect",
          "x": 0,
          "y": 0,
          "width": "100%",
          "height": "100%",
          "radius": 999,
          "fill": "= BranchColour == 'Blue' ? '#a5d8ff' : BranchColour == 'Green' ? '#b2f2bb' : BranchColour == 'Orange' ? '#ffd8a8' : BranchColour == 'Purple' ? '#d0bfff' : BranchColour == 'Red' ? '#ffc9c9' : BranchColour == 'Teal' ? '#96f2d7' : '#e9ecef'",
          "stroke": "= BranchColour == 'Blue' ? '#1c7ed6' : BranchColour == 'Green' ? '#2f9e44' : BranchColour == 'Orange' ? '#f08c00' : BranchColour == 'Purple' ? '#7048e8' : BranchColour == 'Red' ? '#e03131' : BranchColour == 'Teal' ? '#0c8599' : '#868e96'",
          "strokeWidth": 2
        },
        {
          "type": "text",
          "x": 16,
          "y": 4,
          "width": "100% - 32",
          "height": "100% - 8",
          "text": "= Name",
          "wrap": true,
          "fit": "shrink",
          "align": "center",
          "valign": "middle",
          "fill": "#1b1f27",
          "font": {
            "weight": 600
          }
        }
      ],
      "look": {
        "base": "pill",
        "fill": {
          "by": "BranchColour",
          "values": {
            "Blue": "#a5d8ff",
            "Green": "#b2f2bb",
            "Orange": "#ffd8a8",
            "Purple": "#d0bfff",
            "Red": "#ffc9c9",
            "Teal": "#96f2d7"
          },
          "fallback": "#e9ecef"
        },
        "border": {
          "by": "BranchColour",
          "values": {
            "Blue": "#1c7ed6",
            "Green": "#2f9e44",
            "Orange": "#f08c00",
            "Purple": "#7048e8",
            "Red": "#e03131",
            "Teal": "#0c8599"
          },
          "fallback": "#868e96"
        },
        "borderWidth": 2,
        "borderStyle": "solid",
        "title": {
          "attribute": "Name",
          "bold": true
        },
        "size": {
          "width": 160,
          "height": 50,
          "resizable": true
        }
      }
    },
    "shp_idea": {
      "id": "shp_idea",
      "name": "Idea look",
      "kind": "node",
      "size": {
        "width": 170,
        "height": 44,
        "resizable": true,
        "minWidth": 40,
        "minHeight": 28
      },
      "outline": "rect",
      "parts": [
        {
          "type": "rect",
          "x": 0,
          "y": 0,
          "width": "100%",
          "height": "100%",
          "radius": 10,
          "fill": "= BranchColour == 'Blue' ? '#e7f5ff' : BranchColour == 'Green' ? '#ebfbee' : BranchColour == 'Orange' ? '#fff4e6' : BranchColour == 'Purple' ? '#f3f0ff' : BranchColour == 'Red' ? '#fff5f5' : BranchColour == 'Teal' ? '#e6fcf5' : '#f8f9fa'",
          "stroke": "= BranchColour == 'Blue' ? '#1c7ed6' : BranchColour == 'Green' ? '#2f9e44' : BranchColour == 'Orange' ? '#f08c00' : BranchColour == 'Purple' ? '#7048e8' : BranchColour == 'Red' ? '#e03131' : BranchColour == 'Teal' ? '#0c8599' : '#868e96'",
          "strokeWidth": 1.5
        },
        {
          "type": "text",
          "x": 8,

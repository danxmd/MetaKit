          "width": "100% - 16",
          "height": "100% - 8",
          "text": "= Name",
          "wrap": true,
          "fit": "shrink",
          "align": "center",
          "valign": "middle",
          "fill": "#1b1f27",
          "font": {
            "weight": 600
          }
        }
      ],
      "look": {
        "base": "rounded",
        "fill": {
          "by": "BranchColour",
          "values": {
            "Blue": "#e7f5ff",
            "Green": "#ebfbee",
            "Orange": "#fff4e6",
            "Purple": "#f3f0ff",
            "Red": "#fff5f5",
            "Teal": "#e6fcf5"
          },
          "fallback": "#f8f9fa"
        },
        "border": {
          "by": "BranchColour",
          "values": {
            "Blue": "#1c7ed6",
            "Green": "#2f9e44",
            "Orange": "#f08c00",
            "Purple": "#7048e8",
            "Red": "#e03131",
            "Teal": "#0c8599"
          },
          "fallback": "#868e96"
        },
        "borderWidth": 1.5,
        "borderStyle": "solid",
        "title": {
          "attribute": "Name",
          "bold": true
        },
        "size": {
          "width": 170,
          "height": 44,
          "resizable": true
        }
      }
    },
    "shp_concept": {
      "id": "shp_concept",
      "name": "Concept look",
      "kind": "node",
      "size": {
        "width": 170,
        "height": 60,
        "resizable": true,
        "minWidth": 40,
        "minHeight": 28
      },
      "outline": "rect",
      "parts": [
        {
          "type": "rect",
          "x": 0,
          "y": 0,
          "width": "100%",
          "height": "100%",
          "radius": 10,
          "fill": "= Colour == 'Blue' ? '#a5d8ff' : Colour == 'Green' ? '#b2f2bb' : Colour == 'Orange' ? '#ffd8a8' : Colour == 'Purple' ? '#d0bfff' : Colour == 'Red' ? '#ffc9c9' : Colour == 'Teal' ? '#96f2d7' : '#e7f5ff'",
          "stroke": "= Colour == 'Blue' ? '#1c7ed6' : Colour == 'Green' ? '#2f9e44' : Colour == 'Orange' ? '#f08c00' : Colour == 'Purple' ? '#7048e8' : Colour == 'Red' ? '#e03131' : Colour == 'Teal' ? '#0c8599' : '#1c7ed6'",
          "strokeWidth": 1.5
        },
        {
          "type": "text",
          "x": 8,
          "y": 4,
          "width": "100% - 16",
          "height": "100% - 8",
          "text": "= Name",
          "wrap": true,
          "fit": "shrink",
          "align": "center",
          "valign": "middle",
          "fill": "#1b1f27",
          "font": {
            "weight": 600
          }
        }
      ],
      "look": {
        "base": "rounded",
        "fill": {
          "by": "Colour",
          "values": {
            "Blue": "#a5d8ff",
            "Green": "#b2f2bb",
            "Orange": "#ffd8a8",
            "Purple": "#d0bfff",
            "Red": "#ffc9c9",
            "Teal": "#96f2d7"
          },
          "fallback": "#e7f5ff"
        },
        "border": {
          "by": "Colour",
          "values": {
            "Blue": "#1c7ed6",
            "Green": "#2f9e44",
            "Orange": "#f08c00",
            "Purple": "#7048e8",
            "Red": "#e03131",
            "Teal": "#0c8599"
          },
          "fallback": "#1c7ed6"
        },
        "borderWidth": 1.5,
        "borderStyle": "solid",
        "title": {
          "attribute": "Name",
          "bold": true
        },
        "size": {
          "width": 170,
          "height": 60,
          "resizable": true
        }
      }
    },
    "shp_rel_branchesto": {
      "id": "shp_rel_branchesto",
      "name": "BranchesTo look",
      "kind": "relation",
      "line": {
        "stroke": "#868e96",
        "strokeWidth": 2,
        "routing": "curved"
      },
      "look": {
        "colour": "#868e96",
        "width": 2,
        "style": "solid",
        "routing": "curved",
        "start": "none",
        "end": "none",
        "label": null
      }
    },
    "shp_rel_linksto": {

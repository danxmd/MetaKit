{
  "formatVersion": 7,
  "manifest": {
    "id": "kit_privacyropa",
    "name": "Privacy and records of processing",
    "version": "1.0.0",
    "languages": ["en"]
  },
  "settings": {
    "grid": {
      "size": 10,
      "snap": true,
      "visible": true
    },
    "layers": [],
    "numbering": {
      "enabled": false,
      "prefix": "",
      "start": 1
    }
  },
  "classes": {
    "cls_application": {
      "id": "cls_application",
      "key": "Application",
      "kind": "node",
      "labels": {
        "en": "System"
      },
      "help": {
        "en": "A system in which the personal data is kept or used."
      },
      "attributes": [
        {
          "type": "text",
          "key": "Name",
          "required": true,
          "default": "Application",
          "id": "att_application_name",
          "labels": {
            "en": "Name"
          }
        },
        {
          "type": "text",
          "key": "Description",
          "multiline": true,
          "id": "att_application_description",
          "labels": {
            "en": "Description"
          }
        },
        {
          "type": "text",
          "key": "Owner",
          "id": "att_application_owner",
          "labels": {
            "en": "Owner"
          }
        },
        {
          "type": "choice",
          "key": "Lifecycle",
          "options": ["Invest", "Tolerate", "Migrate", "Eliminate"],
          "id": "att_application_lifecycle",
          "labels": {
            "en": "Lifecycle"
          }
        },
        {
          "type": "integer",
          "key": "Users",
          "min": 0,
          "id": "att_application_users",
          "labels": {
            "en": "Users"
          }
        },
        {
          "type": "text",
          "key": "HostingCountry",
          "id": "att_application_hostingcountry",
          "labels": {
            "en": "Hosting country"
          }
        }
      ],
      "shape": "shp_application"
    },
    "cls_processingactivity": {
      "id": "cls_processingactivity",
      "key": "ProcessingActivity",
      "kind": "node",
      "labels": {
        "en": "Processing activity"
      },
      "help": {
        "en": "Something the organisation does with personal data, such as paying staff or keeping patient records: one entry of the records of processing. The fill shows whether an impact assessment is likely needed."
      },
      "attributes": [
        {
          "type": "text",
          "key": "Name",
          "required": true,
          "default": "Processing activity",
          "id": "att_processingactivity_name",
          "labels": {
            "en": "Name"
          }
        },
        {
          "type": "text",
          "key": "Description",
          "multiline": true,
          "id": "att_processingactivity_description",
          "labels": {
            "en": "Description"
          }
        },
        {
          "type": "text",
          "key": "Owner",
          "id": "att_processingactivity_owner",
          "labels": {
            "en": "Owner"
          },
          "help": {
            "en": "The person or team that answers for it."
          }
        },
        {
          "type": "choice",
          "key": "Role",
          "options": ["Controller", "Joint controller", "Processor"],
          "id": "att_processingactivity_role",
          "labels": {
            "en": "Role"
          },
          "help": {
            "en": "Whether the organisation decides why and how the data is used (controller), decides it together with others, or only acts for someone else (processor)."
          }
        },
        {
          "type": "boolean",
          "key": "LargeScale",
          "id": "att_processingactivity_largescale",
          "labels": {
            "en": "Large scale"
          },
          "help": {
            "en": "Many people, much data, a long time or a wide area."
          }
        },
        {
          "type": "boolean",
          "key": "AutomatedDecisions",
          "id": "att_processingactivity_automateddecisions",
          "labels": {
            "en": "Automated decisions"
          },
          "help": {
            "en": "Decisions with legal or similarly important effects on people are made without a person."
          }
        },
        {
          "type": "boolean",
          "key": "SystematicMonitoring",
          "id": "att_processingactivity_systematicmonitoring",
          "labels": {
            "en": "Systematic monitoring"
          },
          "help": {
            "en": "People are observed or tracked in a regular, planned way."
          }
        },
        {
          "type": "boolean",
          "key": "NewTechnology",
          "id": "att_processingactivity_newtechnology",
          "labels": {
            "en": "New technology"
          },
          "help": {
            "en": "New or innovative technology is used, such as biometrics or AI."
          }
        },
        {
          "type": "choice",
          "key": "DPIAStatus",
          "options": ["Not started", "In progress", "Done", "Not needed"],
          "id": "att_processingactivity_dpiastatus",
          "labels": {
            "en": "Impact assessment"
          }
        },
        {
          "type": "formula",
          "key": "Purposes",
          "formula": "join(outgoing('ForPurpose').Name, ', ')",
          "result": "text",
          "id": "att_processingactivity_purposes",
          "labels": {
            "en": "Purposes"
          },
          "help": {
            "en": "The purposes it serves."
          }
        },
        {
          "type": "formula",
          "key": "LegalBases",
          "formula": "join(outgoing('ForPurpose').LegalBasisText, ', ')",
          "result": "text",
          "id": "att_processingactivity_legalbases",
          "labels": {
            "en": "Legal bases"
          },
          "help": {
            "en": "The legal bases of its purposes."
          }
        },
        {
          "type": "formula",
          "key": "Retention",
          "formula": "join(outgoing('KeptFor').Period, ', ')",
          "result": "text",
          "id": "att_processingactivity_retention",
          "labels": {
            "en": "Retention"
          },
          "help": {
            "en": "How long the data is kept."
          }
        },
        {
          "type": "formula",
          "key": "SpecialData",
          "formula": "contains(join(outgoing('Processes').Sensitivity, '|'), 'Special') || contains(join(outgoing('Processes').Sensitivity, '|'), 'Criminal')",
          "result": "boolean",
          "id": "att_processingactivity_specialdata",
          "labels": {
            "en": "Sensitive data"
          },
          "help": {
            "en": "Yes when one of its data categories is a special category or criminal offence data."
          }
        },
        {
          "type": "formula",
          "key": "VulnerableSubjects",
          "formula": "contains(join(outgoing('About').Vulnerable, '|'), 'true')",
          "result": "boolean",
          "id": "att_processingactivity_vulnerablesubjects",
          "labels": {
            "en": "Vulnerable subjects"
          },
          "help": {
            "en": "Yes when one of the groups of people it is about is vulnerable."
          }
        },
        {
          "type": "formula",
          "key": "OutsideTransfers",
          "formula": "contains(join(outgoing('DisclosesTo').OtherCountry, '|'), 'true')",
          "result": "boolean",
          "id": "att_processingactivity_outsidetransfers",
          "labels": {
            "en": "Transfers to other countries"
          },
          "help": {
            "en": "Yes when a recipient receives the data in another country."
          }
        },
        {
          "type": "formula",
          "key": "DPIACriteria",
          "formula": "(SpecialData ? 1 : 0) + (VulnerableSubjects ? 1 : 0) + (LargeScale ? 1 : 0) + (AutomatedDecisions ? 1 : 0) + (SystematicMonitoring ? 1 : 0) + (NewTechnology ? 1 : 0)",
          "result": "number",
          "id": "att_processingactivity_dpiacriteria",
          "labels": {
            "en": "Impact criteria met"
          },
          "help": {
            "en": "How many of these apply: sensitive data, vulnerable people, large scale, automated decisions, systematic monitoring and new technology."
          }
        },
        {
          "type": "formula",
          "key": "DPIAIndication",
          "formula": "DPIACriteria >= 2 ? 'Likely needed' : DPIACriteria == 1 ? 'Consider' : 'Unlikely'",
          "result": "text",
          "id": "att_processingactivity_dpiaindication",
          "labels": {
            "en": "Impact assessment indication"
          },
          "help": {
            "en": "Likely needed from two criteria, Consider with one. An indication for the privacy team, not legal advice."
          }
        }
      ],
      "constraints": [
        {
          "id": "k_activity_purpose",
          "formula": "count(outgoing('ForPurpose')) > 0",
          "message": "= 'Processing activity \"' + Name + '\" has no purpose: connect one with \"For purpose\".'",
          "severity": "warning"
        },
        {
          "id": "k_activity_data",
          "formula": "count(outgoing('Processes')) > 0",
          "message": "= 'Processing activity \"' + Name + '\" names no category of personal data.'",
          "severity": "warning"
        },
        {
          "id": "k_activity_retention",
          "formula": "count(outgoing('KeptFor')) > 0",
          "message": "= 'Processing activity \"' + Name + '\" has no retention rule: say how long the data is kept.'",
          "severity": "warning"
        },
        {
          "id": "k_activity_dpia",
          "formula": "DPIAIndication != 'Likely needed' || DPIAStatus == 'In progress' || DPIAStatus == 'Done'",
          "message": "= 'Processing activity \"' + Name + '\" meets ' + text(DPIACriteria) + ' impact criteria, but no impact assessment is under way.'",
          "severity": "warning"
        }
      ],
      "shape": "shp_processingactivity"
    },
    "cls_purpose": {
      "id": "cls_purpose",
      "key": "Purpose",
      "kind": "node",
      "labels": {
        "en": "Purpose"
      },
      "help": {
        "en": "Why personal data is used, such as \"paying salaries\". Each purpose needs a legal basis."
      },
      "attributes": [
        {
          "type": "text",
          "key": "Name",
          "required": true,
          "default": "Purpose",
          "id": "att_purpose_name",
          "labels": {
            "en": "Name"
          }
        },
        {
          "type": "text",
          "key": "Description",
          "multiline": true,
          "id": "att_purpose_description",
          "labels": {
            "en": "Description"
          }
        },
        {
          "type": "formula",
          "key": "LegalBasisText",
          "formula": "join(outgoing('ReliesOn').Basis, ', ')",
          "result": "text",
          "id": "att_purpose_legalbasistext",
          "labels": {
            "en": "Legal basis"
          },
          "help": {
            "en": "The legal basis it relies on."
          }
        }
      ],
      "constraints": [
        {
          "id": "k_purpose_basis",
          "formula": "count(outgoing('ReliesOn')) > 0",
          "message": "= 'Purpose \"' + Name + '\" has no legal basis: connect one with \"Relies on\".'",
          "severity": "warning"
        }
      ],
      "shape": "shp_purpose"
    },
    "cls_legalbasis": {
      "id": "cls_legalbasis",
      "key": "LegalBasis",
      "kind": "node",
      "labels": {
        "en": "Legal basis"
      },
      "help": {
        "en": "The ground that allows a use of personal data, such as a contract or a legal obligation, with the rule it rests on."
      },
      "attributes": [
        {
          "type": "text",
          "key": "Name",
          "required": true,
          "default": "Legal basis",
          "id": "att_legalbasis_name",
          "labels": {
            "en": "Name"
          }
        },
        {
          "type": "choice",
          "key": "Basis",
          "options": [
            "Consent",
            "Contract",
            "Legal obligation",
            "Vital interests",
            "Public task",
            "Legitimate interests"
          ],
          "id": "att_legalbasis_basis",
          "labels": {
            "en": "Basis"
          }
        },
        {
          "type": "text",
          "key": "Reference",
          "id": "att_legalbasis_reference",
          "labels": {
            "en": "Reference"
          },
          "help": {
            "en": "The law, article or agreement it rests on."
          }
        },
        {
          "type": "text",
          "key": "Notes",
          "multiline": true,
          "id": "att_legalbasis_notes",
          "labels": {
            "en": "Notes"
          },
          "help": {
            "en": "For legitimate interests: the balance between the interests of the organisation and those of the people concerned."
          }
        }
      ],
      "shape": "shp_legalbasis"
    },
    "cls_datacategory": {
      "id": "cls_datacategory",
      "key": "DataCategory",
      "kind": "node",
      "labels": {
        "en": "Data category"
      },
      "help": {
        "en": "A kind of personal data, such as contact details or health data. Special categories, such as health or religion, need extra care."
      },
      "attributes": [
        {
          "type": "text",
          "key": "Name",
          "required": true,
          "default": "Data category",
          "id": "att_datacategory_name",
          "labels": {
            "en": "Name"
          }
        },
        {
          "type": "choice",
          "key": "Sensitivity",
          "options": ["Ordinary", "Special category", "Criminal offence data"],
          "default": "Ordinary",
          "id": "att_datacategory_sensitivity",
          "labels": {
            "en": "Sensitivity"
          }
        },
        {
          "type": "text",
          "key": "Examples",
          "id": "att_datacategory_examples",
          "labels": {
            "en": "Examples"
          },
          "help": {
            "en": "Such as \"name, address and phone\"."
          }
        },
        {
          "type": "text",
          "key": "Source",
          "id": "att_datacategory_source",
          "labels": {
            "en": "Source"
          },
          "help": {
            "en": "Where the data comes from, such as \"from the person\" or \"from a referring doctor\"."
          }
        }
      ],
      "shape": "shp_datacategory"
    },
    "cls_datasubject": {
      "id": "cls_datasubject",
      "key": "DataSubject",
      "kind": "node",
      "labels": {
        "en": "Data subject"
      },
      "help": {
        "en": "A group of people the personal data is about, such as employees or patients."
      },
      "attributes": [
        {
          "type": "text",
          "key": "Name",
          "required": true,
          "default": "Data subject",
          "id": "att_datasubject_name",
          "labels": {
            "en": "Name"
          }
        },
        {
          "type": "boolean",
          "key": "Vulnerable",
          "id": "att_datasubject_vulnerable",
          "labels": {
            "en": "Vulnerable"
          },
          "help": {
            "en": "Children, patients, employees towards their employer or others who cannot easily object."
          }
        },
        {
          "type": "text",
          "key": "Number",
          "id": "att_datasubject_number",
          "labels": {
            "en": "Number"
          },
          "help": {
            "en": "About how many people, such as \"40,000\"."
          }
        }
      ],
      "shape": "shp_datasubject"
    },
    "cls_recipient": {
      "id": "cls_recipient",
      "key": "Recipient",
      "kind": "node",
      "labels": {
        "en": "Recipient"
      },
      "help": {
        "en": "Who receives the personal data: a department, a processor, another organisation or an authority. Data received in another country needs a safeguard."
      },
      "attributes": [
        {
          "type": "text",
          "key": "Name",
          "required": true,
          "default": "Recipient",
          "id": "att_recipient_name",
          "labels": {
            "en": "Name"
          }
        },
        {
          "type": "choice",
          "key": "RecipientType",
          "options": [
            "Internal",
            "Processor",
            "Other controller",
            "Public authority"
          ],
          "id": "att_recipient_recipienttype",
          "labels": {
            "en": "Type"
          }
        },
        {
          "type": "text",
          "key": "Country",
          "id": "att_recipient_country",
          "labels": {
            "en": "Country"
          }
        },
        {
          "type": "boolean",
          "key": "OtherCountry",
          "id": "att_recipient_othercountry",
          "labels": {
            "en": "Transfer to another country"
          },
          "help": {
            "en": "Yes when the data is received in a country outside the area whose privacy law applies."
          }
        },
        {
          "type": "choice",
          "key": "Safeguard",
          "options": [
            "Adequacy decision",
            "Standard contractual clauses",
            "Binding corporate rules",
            "Specific exemption",
            "None yet"
          ],
          "id": "att_recipient_safeguard",
          "labels": {
            "en": "Safeguard"
          },
          "help": {
            "en": "What protects the data abroad."
          }
        },
        {
          "type": "formula",
          "key": "TransferText",
          "formula": "OtherCountry ? (Country ?? 'Abroad') + ': ' + (Safeguard ?? 'no safeguard') : RecipientType",
          "result": "text",
          "id": "att_recipient_transfertext",
          "labels": {
            "en": "Transfer text"
          },
          "help": {
            "en": "The country and the safeguard of a transfer, or the type of recipient. Shown under the name."
          }
        }
      ],
      "constraints": [
        {
          "id": "k_recipient_safeguard",
          "formula": "!OtherCountry || (!isEmpty(Safeguard) && Safeguard != 'None yet')",
          "message": "= 'Recipient \"' + Name + '\" receives data in another country without a safeguard.'",
          "severity": "warning"
        }
      ],
      "shape": "shp_recipient"
    },
    "cls_retentionrule": {
      "id": "cls_retentionrule",
      "key": "RetentionRule",
      "kind": "node",
      "labels": {
        "en": "Retention rule"
      },
      "help": {
        "en": "How long data is kept, from when, and what happens after that."
      },
      "attributes": [
        {
          "type": "text",
          "key": "Name",
          "required": true,
          "default": "Retention rule",
          "id": "att_retentionrule_name",
          "labels": {
            "en": "Name"
          }
        },
        {
          "type": "text",
          "key": "Period",
          "id": "att_retentionrule_period",
          "labels": {
            "en": "Period"
          },
          "help": {
            "en": "Such as \"7 years\"."
          }
        },
        {
          "type": "integer",
          "key": "Months",
          "min": 0,
          "id": "att_retentionrule_months",
          "labels": {
            "en": "Months"
          },
          "help": {
            "en": "The same period in months."
          }
        },
        {
          "type": "text",
          "key": "StartsAt",
          "id": "att_retentionrule_startsat",
          "labels": {
            "en": "Counted from"
          },
          "help": {
            "en": "Such as \"the end of the contract\"."
          }
        },
        {
          "type": "choice",
          "key": "Then",
          "options": ["Delete", "Anonymise", "Archive"],
          "id": "att_retentionrule_then",
          "labels": {
            "en": "Then"
          }
        }
      ],
      "shape": "shp_retentionrule"
    }
  },
  "relations": {
    "rel_forpurpose": {
      "id": "rel_forpurpose",
      "key": "ForPurpose",
      "labels": {
        "en": "For purpose"
      },
      "help": {
        "en": "The processing activity serves the purpose."
      },
      "from": ["cls_processingactivity"],
      "to": ["cls_purpose"],
      "attributes": [],
      "shape": "shp_rel_forpurpose"
    },
    "rel_relieson": {
      "id": "rel_relieson",
      "key": "ReliesOn",
      "labels": {
        "en": "Relies on"
      },
      "help": {
        "en": "The purpose rests on the legal basis."
      },
      "from": ["cls_purpose"],
      "to": ["cls_legalbasis"],
      "attributes": [],
      "shape": "shp_rel_relieson"
    },
    "rel_processes": {
      "id": "rel_processes",
      "key": "Processes",
      "labels": {
        "en": "Processes"
      },
      "help": {
        "en": "The processing activity uses data of this category."
      },
      "from": ["cls_processingactivity"],
      "to": ["cls_datacategory"],
      "attributes": [],
      "shape": "shp_rel_processes"
    },
    "rel_about": {
      "id": "rel_about",
      "key": "About",
      "labels": {
        "en": "About"
      },
      "help": {
        "en": "The personal data is about this group of people."
      },
      "from": ["cls_processingactivity"],
      "to": ["cls_datasubject"],
      "attributes": [],
      "shape": "shp_rel_about"
    },
    "rel_disclosesto": {
      "id": "rel_disclosesto",
      "key": "DisclosesTo",
      "labels": {
        "en": "Discloses to"
      },
      "help": {
        "en": "The processing activity passes personal data to the recipient."
      },
      "from": ["cls_processingactivity"],
      "to": ["cls_recipient"],
      "attributes": [],
      "shape": "shp_rel_disclosesto"
    },
    "rel_keptfor": {
      "id": "rel_keptfor",
      "key": "KeptFor",
      "labels": {
        "en": "Kept for"
      },
      "help": {
        "en": "The data of the processing activity is kept as the retention rule says."
      },
      "from": ["cls_processingactivity"],
      "to": ["cls_retentionrule"],
      "attributes": [],
      "shape": "shp_rel_keptfor"
    },
    "rel_usessystem": {
      "id": "rel_usessystem",
      "key": "UsesSystem",
      "labels": {
        "en": "Uses system"
      },
      "help": {
        "en": "The processing activity keeps or uses the data in the system."
      },
      "from": ["cls_processingactivity"],
      "to": ["cls_application"],
      "attributes": [],
      "shape": "shp_rel_usessystem"
    }
  },
  "modelTypes": {
    "mt_records": {
      "id": "mt_records",
      "key": "Records",
      "labels": {
        "en": "Records of processing"
      },
      "classes": [
        "cls_application",
        "cls_processingactivity",
        "cls_purpose",
        "cls_legalbasis",
        "cls_datacategory",
        "cls_datasubject",
        "cls_recipient",
        "cls_retentionrule"
      ],
      "relations": [
        "rel_forpurpose",
        "rel_relieson",
        "rel_processes",
        "rel_about",
        "rel_disclosesto",
        "rel_keptfor",
        "rel_usessystem"
      ],
      "views": [
        {
          "id": "vw_lawfulness",
          "key": "Lawfulness",
          "labels": {
            "en": "Purposes and legal bases"
          },
          "classes": [
            "cls_processingactivity",
            "cls_purpose",
            "cls_legalbasis"
          ],
          "relations": ["rel_forpurpose", "rel_relieson"]
        },
        {
          "id": "vw_data",
          "key": "Data",
          "labels": {
            "en": "Data, people and recipients"
          },
          "classes": [
            "cls_processingactivity",
            "cls_datacategory",
            "cls_datasubject",
            "cls_recipient",
            "cls_retentionrule",
            "cls_application"
          ],
          "relations": [
            "rel_processes",
            "rel_about",
            "rel_disclosesto",
            "rel_keptfor",
            "rel_usessystem"
          ]
        }
      ],
      "cardinalities": [],
      "attributes": [
        {
          "type": "text",
          "key": "Title",
          "required": true,
          "maxLength": 100,
          "id": "att_mtrecords_title",
          "labels": {
            "en": "Title"
          }
        },
        {
          "type": "text",
          "key": "Organisation",
          "id": "att_mtrecords_organisation",
          "labels": {
            "en": "Organisation"
          }
        },
        {
          "type": "text",
          "key": "PrivacyContact",
          "id": "att_mtrecords_privacycontact",

{
  "formatVersion": 7,
  "manifest": {
    "id": "kit_clouddatamigration",
    "name": "Cloud data migration",
    "version": "1.0.0",
    "languages": ["en"]
  },
  "settings": {
    "grid": {
      "size": 10,
      "snap": true,
      "visible": true
    },
    "layers": [],
    "numbering": {
      "enabled": false,
      "prefix": "",
      "start": 1
    }
  },
  "classes": {
    "cls_sourcesystem": {
      "id": "cls_sourcesystem",
      "key": "SourceSystem",
      "kind": "node",
      "labels": {
        "en": "Source system"
      },
      "help": {
        "en": "A system or database where the data lives today."
      },
      "attributes": [
        {
          "type": "text",
          "key": "Name",
          "required": true,
          "default": "Source system",
          "id": "att_sourcesystem_name",
          "labels": {
            "en": "Name"
          }
        },
        {
          "type": "text",
          "key": "Description",
          "multiline": true,
          "id": "att_sourcesystem_description",
          "labels": {
            "en": "Description"
          }
        },
        {
          "type": "text",
          "key": "Technology",
          "id": "att_sourcesystem_technology",
          "labels": {
            "en": "Technology"
          }
        },
        {
          "type": "text",
          "key": "Owner",
          "id": "att_sourcesystem_owner",
          "labels": {
            "en": "Owner"
          }
        },
        {
          "type": "choice",
          "key": "Hosting",
          "options": ["On-premises", "Cloud", "Software as a service"],
          "id": "att_sourcesystem_hosting",
          "labels": {
            "en": "Hosting"
          }
        },
        {
          "type": "date",
          "key": "Decommission",
          "id": "att_sourcesystem_decommission",
          "labels": {
            "en": "Switch off"
          },
          "help": {
            "en": "When it can be switched off after the move."
          }
        },
        {
          "type": "formula",
          "key": "Workloads",
          "formula": "count(incoming('MovesFrom'))",
          "result": "number",
          "id": "att_sourcesystem_workloads",
          "labels": {
            "en": "Workloads"
          },
          "help": {
            "en": "How many workloads move away from it."
          }
        }
      ],
      "shape": "shp_sourcesystem"
    },
    "cls_cloudplatform": {
      "id": "cls_cloudplatform",
      "key": "CloudPlatform",
      "kind": "container",
      "labels": {
        "en": "Cloud platform"
      },
      "help": {
        "en": "The cloud account or region the data moves to. Place the target services inside it. The provider is free text."
      },
      "attributes": [
        {
          "type": "text",
          "key": "Name",
          "required": true,
          "default": "Cloud platform",
          "id": "att_cloudplatform_name",
          "labels": {
            "en": "Name"
          }
        },
        {
          "type": "text",
          "key": "Description",
          "multiline": true,
          "id": "att_cloudplatform_description",
          "labels": {
            "en": "Description"
          }
        },
        {
          "type": "text",
          "key": "Provider",
          "id": "att_cloudplatform_provider",
          "labels": {
            "en": "Provider"
          }
        },
        {
          "type": "text",
          "key": "Region",
          "id": "att_cloudplatform_region",
          "labels": {
            "en": "Region"
          }
        }
      ],
      "shape": "shp_cloudplatform"
    },
    "cls_risk": {
      "id": "cls_risk",
      "key": "Risk",
      "kind": "node",
      "labels": {
        "en": "Risk"
      },
      "help": {
        "en": "Something that may go wrong. Score is likelihood times impact; Rating turns it into Low, Medium or High and colours the shape."
      },
      "attributes": [
        {
          "type": "text",
          "key": "Name",
          "required": true,
          "default": "Risk",
          "id": "att_risk_name",
          "labels": {
            "en": "Name"
          }
        },
        {
          "type": "text",
          "key": "Description",
          "multiline": true,
          "id": "att_risk_description",
          "labels": {
            "en": "Description"
          }
        },
        {
          "type": "integer",
          "key": "Likelihood",
          "min": 1,
          "max": 5,
          "id": "att_risk_likelihood",
          "labels": {
            "en": "Likelihood (1 to 5)"
          }
        },
        {
          "type": "integer",
          "key": "Impact",
          "min": 1,
          "max": 5,
          "id": "att_risk_impact",
          "labels": {
            "en": "Impact (1 to 5)"
          }
        },
        {
          "type": "text",
          "key": "Owner",
          "id": "att_risk_owner",
          "labels": {
            "en": "Owner"
          }
        },
        {
          "type": "choice",
          "key": "Status",
          "options": ["Open", "Mitigated", "Accepted", "Closed"],
          "id": "att_risk_status",
          "labels": {
            "en": "Status"
          }
        },
        {
          "type": "formula",
          "key": "Score",
          "formula": "Likelihood == null || Impact == null ? null : Likelihood * Impact",
          "result": "number",
          "id": "att_risk_score",
          "labels": {
            "en": "Score"
          },
          "help": {
            "en": "Likelihood times impact, from 1 to 25."
          }
        },
        {
          "type": "formula",
          "key": "Rating",
          "formula": "Score == null ? null : (Score >= 15 ? 'High' : (Score >= 8 ? 'Medium' : 'Low'))",
          "result": "text",
          "id": "att_risk_rating",
          "labels": {
            "en": "Rating"
          },
          "help": {
            "en": "High from 15, Medium from 8, otherwise Low."
          }
        }
      ],
      "shape": "shp_risk"
    },
    "cls_migrationwave": {
      "id": "cls_migrationwave",
      "key": "MigrationWave",
      "kind": "container",
      "labels": {
        "en": "Migration wave"
      },
      "help": {
        "en": "A group of workloads that move together, in a fixed order. Place its workloads and its cut-over plan inside it. The border shows how ready the wave is."
      },
      "attributes": [
        {
          "type": "text",
          "key": "Name",
          "required": true,
          "default": "Migration wave",
          "id": "att_migrationwave_name",
          "labels": {
            "en": "Name"
          }
        },
        {
          "type": "text",
          "key": "Description",
          "multiline": true,
          "id": "att_migrationwave_description",
          "labels": {
            "en": "Description"
          }
        },
        {
          "type": "integer",
          "key": "Sequence",
          "min": 1,
          "id": "att_migrationwave_sequence",
          "labels": {
            "en": "Sequence"
          },
          "help": {
            "en": "The order of the wave: 1 moves first."
          }
        },
        {
          "type": "date",
          "key": "Start",
          "id": "att_migrationwave_start",
          "labels": {
            "en": "Start"
          }
        },
        {
          "type": "date",
          "key": "End",
          "id": "att_migrationwave_end",
          "labels": {
            "en": "Cut-over date"
          }
        },
        {
          "type": "formula",
          "key": "Workloads",
          "formula": "count(children().Readiness)",
          "result": "number",
          "id": "att_migrationwave_workloads",
          "labels": {
            "en": "Workloads"
          },
          "help": {
            "en": "How many workloads it holds."
          }
        },
        {
          "type": "formula",
          "key": "SizeGB",
          "formula": "sum(children().SizeGB)",
          "result": "number",
          "id": "att_migrationwave_sizegb",
          "labels": {
            "en": "Size (GB)"
          },
          "help": {
            "en": "The size of its workloads together, in gigabytes."
          }
        },
        {
          "type": "formula",
          "key": "Readiness",
          "formula": "IFERROR(round(avg(children().Readiness), 0), null)",
          "result": "number",
          "id": "att_migrationwave_readiness",
          "labels": {
            "en": "Readiness (%)"
          },
          "help": {
            "en": "The average readiness of its workloads, in percent."
          }
        },
        {
          "type": "formula",
          "key": "Progress",
          "formula": "IFERROR(round(avg(children().Progress), 0), null)",
          "result": "number",
          "id": "att_migrationwave_progress",
          "labels": {
            "en": "Progress (%)"
          },
          "help": {
            "en": "The average progress of its workloads, in percent."
          }
        },
        {
          "type": "formula",
          "key": "ReadinessLevel",
          "formula": "Readiness == null ? null : Readiness == 100 ? 'Ready' : Readiness >= 75 ? 'Nearly ready' : 'Not ready'",
          "result": "text",
          "id": "att_migrationwave_readinesslevel",
          "labels": {
            "en": "Readiness level"
          },
          "help": {
            "en": "Ready when every workload is ready, Nearly ready from 75%, otherwise Not ready. The border shows it."
          }
        },
        {
          "type": "formula",
          "key": "Summary",
          "formula": "Name + (Readiness == null ? '' : ' (' + text(Readiness) + '% ready)')",
          "result": "text",
          "id": "att_migrationwave_summary",
          "labels": {
            "en": "Summary"
          },
          "help": {
            "en": "The name and the readiness, shown as the heading."
          }
        }
      ],
      "constraints": [
        {
          "id": "k_wave_dates",
          "formula": "Start == null || End == null || Start <= End",
          "message": "= 'Wave \"' + Name + '\" ends before it starts.'",
          "severity": "warning"
        }
      ],
      "shape": "shp_migrationwave"
    },
    "cls_workload": {
      "id": "cls_workload",
      "key": "Workload",
      "kind": "node",
      "labels": {
        "en": "Workload"
      },
      "help": {
        "en": "Something that moves to the cloud: a database, a warehouse, files, loading jobs or reports. The fill shows its status."
      },
      "attributes": [
        {
          "type": "text",
          "key": "Name",
          "required": true,
          "default": "Workload",
          "id": "att_workload_name",
          "labels": {
            "en": "Name"
          }
        },
        {
          "type": "text",
          "key": "Description",
          "multiline": true,
          "id": "att_workload_description",
          "labels": {
            "en": "Description"
          }
        },
        {
          "type": "choice",
          "key": "WorkloadType",
          "options": [
            "Database",
            "Data warehouse",
            "Files",
            "Loading jobs",
            "Reports",
            "Application data"
          ],
          "id": "att_workload_workloadtype",
          "labels": {
            "en": "Type"
          }
        },
        {
          "type": "number",
          "key": "SizeGB",
          "min": 0,
          "id": "att_workload_sizegb",
          "labels": {
            "en": "Size (GB)"
          }
        },
        {
          "type": "choice",
          "key": "Approach",
          "options": ["Rehost", "Replatform", "Refactor", "Retire", "Retain"],
          "id": "att_workload_approach",
          "labels": {
            "en": "Approach"
          },
          "help": {
            "en": "Rehost moves it as it is, replatform changes the platform a little, refactor rebuilds it, retire switches it off and retain keeps it where it is."
          }
        },
        {
          "type": "choice",
          "key": "Complexity",
          "options": ["Low", "Medium", "High"],
          "id": "att_workload_complexity",
          "labels": {
            "en": "Complexity"
          }
        },
        {
          "type": "choice",
          "key": "Status",
          "options": [
            "Not started",
            "Assessed",
            "Ready",
            "Migrating",
            "Migrated",
            "Validated"
          ],
          "default": "Not started",
          "id": "att_workload_status",
          "labels": {
            "en": "Status"
          }
        },
        {
          "type": "text",
          "key": "Owner",
          "id": "att_workload_owner",
          "labels": {
            "en": "Owner"
          }
        },
        {
          "type": "formula",
          "key": "Wave",
          "formula": "parent ? parent.Name : null",
          "result": "text",
          "id": "att_workload_wave",
          "labels": {
            "en": "Wave"
          },
          "help": {
            "en": "The wave it is planned in."
          }
        },
        {
          "type": "formula",
          "key": "WaveNumber",
          "formula": "parent ? parent.Sequence : null",
          "result": "number",
          "id": "att_workload_wavenumber",
          "labels": {
            "en": "Wave number"
          },
          "help": {
            "en": "The sequence of its wave."
          }
        },
        {
          "type": "formula",
          "key": "LatestDependency",
          "formula": "max(outgoing('DependsOn').WaveNumber)",
          "result": "number",
          "id": "att_workload_latestdependency",
          "labels": {
            "en": "Latest wave it depends on"
          },
          "help": {
            "en": "The latest wave among the workloads it depends on."
          }
        },
        {
          "type": "formula",
          "key": "Readiness",
          "formula": "Status == 'Not started' || Status == null ? 0 : Status == 'Assessed' ? 50 : 100",
          "result": "number",
          "id": "att_workload_readiness",
          "labels": {
            "en": "Readiness (%)"
          },
          "help": {
            "en": "Not started 0%, assessed 50%, ready or later 100%."
          }
        },
        {
          "type": "formula",
          "key": "Progress",
          "formula": "Status == 'Validated' ? 100 : Status == 'Migrated' ? 80 : Status == 'Migrating' ? 60 : Status == 'Ready' ? 40 : Status == 'Assessed' ? 20 : 0",
          "result": "number",
          "id": "att_workload_progress",
          "labels": {
            "en": "Progress (%)"
          },
          "help": {
            "en": "From 0% (not started) to 100% (validated after the move)."
          }
        },
        {
          "type": "formula",
          "key": "StatusText",
          "formula": "(Status ?? 'Not started') + (Approach ? ' · ' + Approach : '')",
          "result": "text",
          "id": "att_workload_statustext",
          "labels": {
            "en": "Status text"
          },
          "help": {
            "en": "The status and the approach, shown under the name."
          }
        }
      ],
      "constraints": [
        {
          "id": "k_workload_order",
          "formula": "WaveNumber == null || LatestDependency == null || LatestDependency <= WaveNumber",
          "message": "= 'Workload \"' + Name + '\" moves in wave ' + text(WaveNumber) + ' but depends on a workload of wave ' + text(LatestDependency) + '.'",
          "severity": "warning"
        },
        {
          "id": "k_workload_wave",
          "formula": "parent != null",
          "message": "= 'Workload \"' + Name + '\" is not planned in a wave: place it inside one.'",
          "severity": "warning"
        },
        {
          "id": "k_workload_target",
          "formula": "Approach == 'Retire' || Approach == 'Retain' || count(outgoing('MovesTo')) > 0",
          "message": "= 'Workload \"' + Name + '\" has no target: connect the service it moves to with \"Moves to\".'",
          "severity": "warning"
        }
      ],
      "shape": "shp_workload"
    },
    "cls_targetservice": {
      "id": "cls_targetservice",
      "key": "TargetService",
      "kind": "node",
      "labels": {
        "en": "Target service"
      },
      "help": {
        "en": "A cloud service that receives workloads, such as object storage or a managed database. Technology is free text."
      },
      "attributes": [
        {
          "type": "text",
          "key": "Name",
          "required": true,
          "default": "Target service",
          "id": "att_targetservice_name",
          "labels": {
            "en": "Name"
          }
        },
        {
          "type": "text",
          "key": "Description",
          "multiline": true,
          "id": "att_targetservice_description",
          "labels": {
            "en": "Description"
          }
        },
        {
          "type": "choice",
          "key": "ServiceType",
          "options": [
            "Object storage",
            "Managed database",
            "Data warehouse",
            "Lakehouse",
            "Integration service",
            "Analytics service"
          ],
          "id": "att_targetservice_servicetype",
          "labels": {
            "en": "Type"
          }
        },
        {
          "type": "text",
          "key": "Technology",
          "id": "att_targetservice_technology",
          "labels": {
            "en": "Technology"
          }
        },
        {
          "type": "text",
          "key": "Region",
          "id": "att_targetservice_region",
          "labels": {
            "en": "Region"
          }
        },
        {
          "type": "formula",
          "key": "Workloads",
          "formula": "count(incoming('MovesTo'))",
          "result": "number",
          "id": "att_targetservice_workloads",
          "labels": {
            "en": "Workloads"
          },
          "help": {
            "en": "How many workloads move to it."
          }
        },
        {
          "type": "formula",
          "key": "IncomingGB",
          "formula": "sum(incoming('MovesTo').SizeGB)",
          "result": "number",
          "id": "att_targetservice_incominggb",
          "labels": {
            "en": "Incoming (GB)"
          },
          "help": {
            "en": "The size of the workloads that move to it, in gigabytes."
          }
        }
      ],
      "shape": "shp_targetservice"
    },
    "cls_cutoverplan": {
      "id": "cls_cutoverplan",
      "key": "CutoverPlan",
      "kind": "node",
      "labels": {
        "en": "Cut-over plan"
      },
      "help": {
        "en": "How a wave switches over: the window, the go or no-go decision and how to go back if it fails. Place it inside its wave."
      },
      "attributes": [
        {
          "type": "text",
          "key": "Name",
          "required": true,
          "default": "Cut-over plan",
          "id": "att_cutoverplan_name",
          "labels": {
            "en": "Name"
          }
        },
        {
          "type": "text",
          "key": "Window",
          "id": "att_cutoverplan_window",
          "labels": {
            "en": "Window"
          },
          "help": {
            "en": "When the switch happens, such as \"Saturday 22:00 to Sunday 06:00\"."
          }
        },
        {
          "type": "text",
          "key": "Owner",
          "id": "att_cutoverplan_owner",
          "labels": {
            "en": "Owner"
          }
        },
        {
          "type": "choice",
          "key": "Decision",
          "options": ["Not decided", "Go", "No go"],
          "default": "Not decided",
          "id": "att_cutoverplan_decision",
          "labels": {
            "en": "Go or no go"
          }
        },
        {
          "type": "text",
          "key": "Steps",
          "multiline": true,
          "id": "att_cutoverplan_steps",
          "labels": {
            "en": "Steps"
          }
        },
        {
          "type": "text",
          "key": "RollbackPlan",
          "multiline": true,
          "id": "att_cutoverplan_rollbackplan",
          "labels": {
            "en": "Rollback plan"
          },
          "help": {
            "en": "How to switch back to the old systems if the cut-over fails."
          }
        },
        {
          "type": "formula",
          "key": "Wave",
          "formula": "parent ? parent.Name : null",
          "result": "text",
          "id": "att_cutoverplan_wave",
          "labels": {
            "en": "Wave"
          },
          "help": {
            "en": "The wave it belongs to."
          }
        }
      ],
      "constraints": [
        {
          "id": "k_cutover_rollback",
          "formula": "!isEmpty(RollbackPlan)",
          "message": "= 'Cut-over plan \"' + Name + '\" has no rollback plan.'",
          "severity": "warning"
        }
      ],
      "shape": "shp_cutoverplan"
    }
  },
  "relations": {
    "rel_movesfrom": {
      "id": "rel_movesfrom",
      "key": "MovesFrom",
      "labels": {
        "en": "Moves from"
      },
      "help": {
        "en": "The workload leaves this source system."
      },
      "from": ["cls_workload"],
      "to": ["cls_sourcesystem"],
      "attributes": [],
      "shape": "shp_rel_movesfrom"
    },
    "rel_movesto": {
      "id": "rel_movesto",
      "key": "MovesTo",
      "labels": {
        "en": "Moves to"
      },
      "help": {
        "en": "The workload lands in this target service."
      },
      "from": ["cls_workload"],
      "to": ["cls_targetservice"],
      "attributes": [],
      "shape": "shp_rel_movesto"
    },
    "rel_dependson": {
      "id": "rel_dependson",
      "key": "DependsOn",
      "labels": {
        "en": "Depends on"
      },
      "help": {
        "en": "The workload needs the other one to move first, or in the same wave."
      },
      "from": ["cls_workload"],
      "to": ["cls_workload"],
      "attributes": [],
      "shape": "shp_rel_dependson"
    },
    "rel_hasrisk": {
      "id": "rel_hasrisk",
      "key": "HasRisk",
      "labels": {
        "en": "Has risk"
      },
      "help": {
        "en": "The workload or the wave is exposed to the risk."
      },
      "from": ["cls_workload", "cls_migrationwave"],
      "to": ["cls_risk"],
      "attributes": [],
      "shape": "shp_rel_hasrisk"
    }
  },
  "modelTypes": {
    "mt_migration": {
      "id": "mt_migration",
      "key": "Migration",
      "labels": {
        "en": "Cloud data migration"
      },
      "classes": [
        "cls_sourcesystem",
        "cls_cloudplatform",
        "cls_risk",
        "cls_migrationwave",
        "cls_workload",
        "cls_targetservice",
        "cls_cutoverplan"
      ],
      "relations": [
        "rel_movesfrom",
        "rel_movesto",
        "rel_dependson",
        "rel_hasrisk"
      ],
      "views": [
        {
          "id": "vw_plan",
          "key": "Plan",
          "labels": {
            "en": "Waves and dependencies"
          },
          "classes": [
            "cls_migrationwave",
            "cls_workload",
            "cls_cutoverplan",
            "cls_risk"
          ],
          "relations": ["rel_dependson", "rel_hasrisk"]
        },
        {
          "id": "vw_systems",
          "key": "Systems",
          "labels": {
            "en": "From and to"
          },
          "classes": [
            "cls_sourcesystem",
            "cls_workload",
            "cls_cloudplatform",
            "cls_targetservice"
          ],
          "relations": ["rel_movesfrom", "rel_movesto"]
        }
      ],
      "cardinalities": [],
      "attributes": [
        {
          "type": "text",
          "key": "Title",
          "required": true,
          "maxLength": 100,
          "id": "att_mtmigration_title",
          "labels": {
            "en": "Title"
          }
        },
        {
          "type": "text",
          "key": "Organisation",
          "id": "att_mtmigration_organisation",
          "labels": {
            "en": "Organisation"
          }
        },
        {
          "type": "formula",
          "key": "TotalGB",
          "formula": "sum(objects('Workload').SizeGB)",
          "result": "number",
          "id": "att_mtmigration_totalgb",
          "labels": {
            "en": "Total size (GB)"
          },
          "help": {
            "en": "The size of all workloads, in gigabytes."
          }
        },
        {
          "type": "formula",
          "key": "OverallProgress",
          "formula": "IFERROR(round(avg(objects('Workload').Progress), 0), null)",
          "result": "number",
          "id": "att_mtmigration_overallprogress",
          "labels": {
            "en": "Overall progress (%)"
          },
          "help": {
            "en": "The average progress of all workloads, in percent."
          }
        }
      ],
      "help": {
        "en": "Source systems, workloads planned in migration waves with cut-over plans, target services in a cloud platform, dependencies and risks."
      },
      "containers": {
        "cls_migrationwave": ["cls_workload", "cls_cutoverplan"],
        "cls_cloudplatform": ["cls_targetservice"]
      }
    }
  },

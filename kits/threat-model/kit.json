{
  "formatVersion": 7,
  "manifest": {
    "id": "kit_threatmodel",
    "name": "Security threat model",
    "version": "1.0.0",
    "languages": ["en"]
  },
  "settings": {
    "grid": {
      "size": 10,
      "snap": true,
      "visible": true
    },
    "layers": [],
    "numbering": {
      "enabled": false,
      "prefix": "",
      "start": 1
    }
  },
  "classes": {
    "cls_trustboundary": {
      "id": "cls_trustboundary",
      "key": "TrustBoundary",
      "kind": "swimlane",
      "labels": {
        "en": "Trust boundary"
      },
      "help": {
        "en": "A line inside which everything trusts everything else to the same degree, such as a company network. Data that crosses it needs protection. A lane for the processes, data stores and entities inside it."
      },
      "attributes": [
        {
          "type": "text",
          "key": "Name",
          "required": true,
          "default": "Trust boundary",
          "id": "att_trustboundary_name",
          "labels": {
            "en": "Name"
          }
        },
        {
          "type": "text",
          "key": "Description",
          "multiline": true,
          "id": "att_trustboundary_description",
          "labels": {
            "en": "Description"
          }
        },
        {
          "type": "choice",
          "key": "TrustLevel",
          "options": ["Untrusted", "Partly trusted", "Trusted"],
          "id": "att_trustboundary_trustlevel",
          "labels": {
            "en": "Trust level"
          }
        }
      ],
      "shape": "shp_trustboundary"
    },
    "cls_process": {
      "id": "cls_process",
      "key": "Process",
      "kind": "node",
      "labels": {
        "en": "Process"
      },
      "help": {
        "en": "Software that handles data, such as a web application or a service."
      },
      "attributes": [
        {
          "type": "text",
          "key": "Name",
          "required": true,
          "default": "Process",
          "id": "att_process_name",
          "labels": {
            "en": "Name"
          }
        },
        {
          "type": "text",
          "key": "Description",
          "multiline": true,
          "id": "att_process_description",
          "labels": {
            "en": "Description"
          }
        },
        {
          "type": "text",
          "key": "Technology",
          "id": "att_process_technology",
          "labels": {
            "en": "Technology"
          }
        },
        {
          "type": "text",
          "key": "RunsAs",
          "id": "att_process_runsas",
          "labels": {
            "en": "Runs as"
          },
          "help": {
            "en": "The account or privilege it runs with."
          }
        }
      ],
      "shape": "shp_process"
    },
    "cls_datastore": {
      "id": "cls_datastore",
      "key": "DataStore",
      "kind": "node",
      "labels": {
        "en": "Data store"
      },
      "help": {
        "en": "Where data is kept, such as a database, a file store or a queue."
      },
      "attributes": [
        {
          "type": "text",
          "key": "Name",
          "required": true,
          "default": "Data store",
          "id": "att_datastore_name",
          "labels": {
            "en": "Name"
          }
        },
        {
          "type": "text",
          "key": "Description",
          "multiline": true,
          "id": "att_datastore_description",
          "labels": {
            "en": "Description"
          }
        },
        {
          "type": "text",
          "key": "Technology",
          "id": "att_datastore_technology",
          "labels": {
            "en": "Technology"
          }
        },
        {
          "type": "choice",
          "key": "Classification",
          "options": ["Public", "Internal", "Confidential", "Restricted"],
          "id": "att_datastore_classification",
          "labels": {
            "en": "Classification"
          }
        }
      ],
      "shape": "shp_datastore"
    },
    "cls_externalentity": {
      "id": "cls_externalentity",
      "key": "ExternalEntity",
      "kind": "node",
      "labels": {
        "en": "External entity"
      },
      "help": {
        "en": "A person or system outside the scope of the model that sends or receives data, such as a user or a partner system."
      },
      "attributes": [
        {
          "type": "text",
          "key": "Name",
          "required": true,
          "default": "External entity",
          "id": "att_externalentity_name",
          "labels": {
            "en": "Name"
          }
        },
        {
          "type": "text",
          "key": "Description",
          "multiline": true,
          "id": "att_externalentity_description",
          "labels": {
            "en": "Description"
          }
        },
        {
          "type": "choice",
          "key": "Kind",
          "options": ["Person", "System", "Organisation"],
          "id": "att_externalentity_kind",
          "labels": {
            "en": "Kind"
          }
        }
      ],
      "shape": "shp_externalentity"
    },
    "cls_asset": {
      "id": "cls_asset",
      "key": "Asset",
      "kind": "node",
      "labels": {
        "en": "Asset"
      },
      "help": {
        "en": "Something worth protecting, such as personal data, money or the good name of the organisation."
      },
      "attributes": [
        {
          "type": "text",
          "key": "Name",
          "required": true,
          "default": "Asset",
          "id": "att_asset_name",
          "labels": {
            "en": "Name"
          }
        },
        {
          "type": "text",
          "key": "Description",
          "multiline": true,
          "id": "att_asset_description",
          "labels": {
            "en": "Description"
          }
        },
        {
          "type": "choice",
          "key": "Classification",
          "options": ["Public", "Internal", "Confidential", "Restricted"],
          "id": "att_asset_classification",
          "labels": {
            "en": "Classification"
          }
        },
        {
          "type": "text",
          "key": "Owner",
          "id": "att_asset_owner",
          "labels": {
            "en": "Owner"
          }
        }
      ],
      "shape": "shp_asset"
    },
    "cls_threat": {
      "id": "cls_threat",
      "key": "Threat",
      "kind": "node",
      "labels": {
        "en": "Threat"
      },
      "help": {
        "en": "Something an attacker or an accident could do, sorted into one of the six STRIDE categories and scored by likelihood times impact."
      },
      "attributes": [
        {
          "type": "text",
          "key": "Name",
          "required": true,
          "default": "Threat",
          "id": "att_threat_name",
          "labels": {
            "en": "Name"
          }
        },
        {
          "type": "text",
          "key": "Description",
          "multiline": true,
          "id": "att_threat_description",
          "labels": {
            "en": "Description"
          }
        },
        {
          "type": "choice",
          "key": "Category",
          "options": [
            "Spoofing",
            "Tampering",
            "Repudiation",
            "Information disclosure",
            "Denial of service",
            "Elevation of privilege"
          ],
          "id": "att_threat_category",
          "labels": {
            "en": "Category"
          },
          "help": {
            "en": "Spoofing: pretending to be someone else. Tampering: changing data. Repudiation: denying an action. Information disclosure: reading what one should not. Denial of service: making it unavailable. Elevation of privilege: gaining rights one should not have."
          }
        },
        {
          "type": "integer",
          "key": "Likelihood",
          "min": 1,
          "max": 5,
          "id": "att_threat_likelihood",
          "labels": {
            "en": "Likelihood (1 to 5)"
          }
        },
        {
          "type": "integer",
          "key": "Impact",
          "min": 1,
          "max": 5,
          "id": "att_threat_impact",
          "labels": {
            "en": "Impact (1 to 5)"
          }
        },
        {
          "type": "choice",
          "key": "Status",
          "options": ["Open", "Mitigated", "Accepted", "Transferred"],
          "default": "Open",
          "id": "att_threat_status",
          "labels": {
            "en": "Status"
          }
        },
        {
          "type": "text",
          "key": "Owner",
          "id": "att_threat_owner",
          "labels": {
            "en": "Owner"
          }
        },
        {
          "type": "formula",
          "key": "Score",
          "formula": "Likelihood == null || Impact == null ? null : Likelihood * Impact",
          "result": "number",
          "id": "att_threat_score",
          "labels": {
            "en": "Score"
          },
          "help": {
            "en": "Likelihood times impact, from 1 to 25."
          }
        },
        {
          "type": "formula",
          "key": "Rating",
          "formula": "Score == null ? null : (Score >= 15 ? 'High' : (Score >= 8 ? 'Medium' : 'Low'))",
          "result": "text",
          "id": "att_threat_rating",
          "labels": {
            "en": "Rating"
          },
          "help": {
            "en": "High from 15, Medium from 8, otherwise Low. It colours the threat."
          }
        },
        {
          "type": "formula",
          "key": "Mitigations",
          "formula": "count(incoming('Mitigates'))",
          "result": "number",
          "id": "att_threat_mitigations",
          "labels": {
            "en": "Mitigations"
          },
          "help": {
            "en": "How many mitigations work against it."
          }
        }
      ],
      "constraints": [
        {
          "id": "k_threat_high",
          "formula": "Rating != 'High' || Status == 'Accepted' || Status == 'Transferred' || Mitigations > 0",
          "message": "= 'High threat \"' + Name + '\" has no mitigation: connect one with \"Mitigates\", or record that the risk is accepted or transferred.'",
          "severity": "warning"
        },
        {
          "id": "k_threat_target",
          "formula": "count(outgoing('Threatens')) > 0",
          "message": "= 'Threat \"' + Name + '\" threatens nothing: connect it to the process, data store, entity or asset at risk.'",
          "severity": "warning"
        }
      ],
      "shape": "shp_threat"
    },
    "cls_mitigation": {
      "id": "cls_mitigation",
      "key": "Mitigation",
      "kind": "node",
      "labels": {
        "en": "Mitigation"
      },
      "help": {
        "en": "A measure that makes a threat less likely or less harmful, such as encryption or an audit log."
      },
      "attributes": [
        {
          "type": "text",
          "key": "Name",
          "required": true,
          "default": "Mitigation",
          "id": "att_mitigation_name",
          "labels": {
            "en": "Name"
          }
        },
        {
          "type": "text",
          "key": "Description",
          "multiline": true,
          "id": "att_mitigation_description",
          "labels": {
            "en": "Description"
          }
        },
        {
          "type": "choice",
          "key": "Kind",
          "options": ["Prevent", "Detect", "Respond"],
          "id": "att_mitigation_kind",
          "labels": {
            "en": "Kind"
          }
        },
        {
          "type": "choice",
          "key": "Status",
          "options": ["Planned", "In progress", "In place", "Verified"],
          "default": "Planned",
          "id": "att_mitigation_status",
          "labels": {
            "en": "Status"
          }
        },
        {
          "type": "text",
          "key": "Owner",
          "id": "att_mitigation_owner",
          "labels": {
            "en": "Owner"
          }
        },
        {
          "type": "date",
          "key": "Due",
          "id": "att_mitigation_due",
          "labels": {
            "en": "Due"
          }
        }
      ],
      "constraints": [
        {
          "id": "k_mitigation_target",
          "formula": "count(outgoing('Mitigates')) > 0",
          "message": "= 'Mitigation \"' + Name + '\" mitigates no threat.'",
          "severity": "warning"
        }
      ],
      "shape": "shp_mitigation"
    }
  },
  "relations": {
    "rel_dataflow": {
      "id": "rel_dataflow",
      "key": "DataFlow",
      "labels": {
        "en": "Data flow"
      },
      "help": {
        "en": "Data moves from one process, store or entity to another. A flow that crosses a trust boundary is drawn red until it is encrypted and authenticated."
      },
      "from": ["cls_process", "cls_datastore", "cls_externalentity"],
      "to": ["cls_process", "cls_datastore", "cls_externalentity"],
      "attributes": [
        {
          "type": "text",
          "key": "Data",
          "id": "att_dataflow_data",
          "labels": {
            "en": "Data"
          },
          "help": {
            "en": "What moves, such as \"expense claims\"."
          }
        },
        {
          "type": "text",
          "key": "Protocol",
          "id": "att_dataflow_protocol",
          "labels": {
            "en": "Protocol"
          },
          "help": {
            "en": "How it moves, such as \"HTTPS\"."
          }
        },
        {
          "type": "boolean",
          "key": "Encrypted",
          "id": "att_dataflow_encrypted",
          "labels": {
            "en": "Encrypted"
          }
        },
        {
          "type": "boolean",
          "key": "Authenticated",
          "id": "att_dataflow_authenticated",
          "labels": {
            "en": "Authenticated"
          },
          "help": {
            "en": "Yes when both ends prove who they are."
          }
        },
        {
          "type": "formula",
          "key": "CrossesBoundary",
          "formula": "from.parent != to.parent",
          "result": "boolean",
          "id": "att_dataflow_crossesboundary",
          "labels": {
            "en": "Crosses a boundary"
          },
          "help": {
            "en": "Yes when the two ends sit in different trust boundaries, or one of them in none."
          }
        },
        {
          "type": "formula",
          "key": "Unprotected",
          "formula": "CrossesBoundary && !(Encrypted == true && Authenticated == true)",
          "result": "boolean",
          "id": "att_dataflow_unprotected",
          "labels": {
            "en": "Unprotected"
          },
          "help": {
            "en": "Yes when it crosses a trust boundary without being both encrypted and authenticated. It colours the line."
          }
        },
        {
          "type": "formula",
          "key": "Label",
          "formula": "(Data ?? '') + (isEmpty(Protocol) ? '' : ' [' + Protocol + ']')",
          "result": "text",
          "id": "att_dataflow_label",
          "labels": {
            "en": "Label"
          },
          "help": {
            "en": "The data and the protocol, shown on the line."
          }
        }
      ],
      "shape": "shp_rel_dataflow",
      "constraints": [
        {
          "id": "k_flow_boundary",
          "formula": "!Unprotected",
          "message": "= 'The data flow \"' + (Data ?? '') + '\" from \"' + from.Name + '\" to \"' + to.Name + '\" crosses a trust boundary but is not ' + (Encrypted == true ? 'authenticated' : (Authenticated == true ? 'encrypted' : 'encrypted or authenticated')) + '.'",
          "severity": "warning"
        }
      ]
    },
    "rel_threatens": {
      "id": "rel_threatens",
      "key": "Threatens",
      "labels": {
        "en": "Threatens"
      },
      "help": {
        "en": "The threat puts this process, store, entity or asset at risk."
      },
      "from": ["cls_threat"],
      "to": ["cls_process", "cls_datastore", "cls_externalentity", "cls_asset"],
      "attributes": [],
      "shape": "shp_rel_threatens"
    },
    "rel_mitigates": {
      "id": "rel_mitigates",
      "key": "Mitigates",
      "labels": {
        "en": "Mitigates"
      },
      "help": {
        "en": "The mitigation works against the threat."
      },
      "from": ["cls_mitigation"],
      "to": ["cls_threat"],
      "attributes": [],
      "shape": "shp_rel_mitigates"
    },
    "rel_holds": {
      "id": "rel_holds",
      "key": "Holds",
      "labels": {
        "en": "Holds"
      },
      "help": {
        "en": "The data store keeps, or the process handles, the asset."
      },
      "from": ["cls_datastore", "cls_process"],
      "to": ["cls_asset"],
      "attributes": [],
      "shape": "shp_rel_holds"
    }
  },
  "modelTypes": {
    "mt_threatmodel": {
      "id": "mt_threatmodel",
      "key": "ThreatModel",
      "labels": {
        "en": "Threat model"
      },
      "classes": [
        "cls_trustboundary",
        "cls_process",
        "cls_datastore",
        "cls_externalentity",
        "cls_asset",
        "cls_threat",
        "cls_mitigation"
      ],
      "relations": [
        "rel_dataflow",
        "rel_threatens",
        "rel_mitigates",
        "rel_holds"
      ],
      "views": [
        {
          "id": "vw_dataflows",
          "key": "DataFlows",
          "labels": {
            "en": "Data flows"
          },
          "classes": [
            "cls_trustboundary",
            "cls_process",
            "cls_datastore",
            "cls_externalentity"
          ],
          "relations": ["rel_dataflow"]
        },
        {
          "id": "vw_threats",
          "key": "Threats",
          "labels": {
            "en": "Threats"
          },
          "classes": [
            "cls_threat",
            "cls_mitigation",
            "cls_asset",
            "cls_process",
            "cls_datastore",
            "cls_externalentity"
          ],
          "relations": ["rel_threatens", "rel_mitigates", "rel_holds"]
        }
      ],
      "cardinalities": [],
      "attributes": [
        {
          "type": "text",
          "key": "Title",
          "required": true,
          "maxLength": 100,
          "id": "att_mtthreatmodel_title",
          "labels": {
            "en": "Title"
          }
        },
        {
          "type": "text",
          "key": "System",
          "id": "att_mtthreatmodel_system",
          "labels": {
            "en": "System"
          }
        },
        {
          "type": "text",
          "key": "Reviewer",
          "id": "att_mtthreatmodel_reviewer",
          "labels": {
            "en": "Reviewer"
          }
        },
        {
          "type": "date",
          "key": "ReviewDate",
          "id": "att_mtthreatmodel_reviewdate",
          "labels": {
            "en": "Review date"
          }
        },
        {
          "type": "formula",
          "key": "Threats",
          "formula": "count(objects('Threat'))",
          "result": "number",
          "id": "att_mtthreatmodel_threats",
          "labels": {
            "en": "Threats"
          },
          "help": {
            "en": "How many threats the model lists."
          }
        },
        {
          "type": "formula",
          "key": "Mitigations",
          "formula": "count(objects('Mitigation'))",
          "result": "number",
          "id": "att_mtthreatmodel_mitigations",
          "labels": {
            "en": "Mitigations"
          },
          "help": {
            "en": "How many mitigations the model lists."
          }
        }
      ],
      "help": {
        "en": "A data flow diagram inside trust boundaries, with the assets, threats and mitigations of the system."
      },
      "containers": {
        "cls_trustboundary": [
          "cls_process",
          "cls_datastore",
          "cls_externalentity",
          "cls_trustboundary"
        ]
      }
    }
  },
  "shapes": {
    "shp_trustboundary": {
      "id": "shp_trustboundary",
      "name": "TrustBoundary look",
      "kind": "node",
      "size": {
        "width": 760,
        "height": 400,
        "resizable": true,
        "minWidth": 40,
        "minHeight": 28
      },
      "outline": "rect",
      "parts": [
        {
          "type": "rect",
          "x": 0,
          "y": 0,
          "width": "100%",
          "height": "100%",
          "fill": "#ffffff00",
          "stroke": "#e03131",
          "strokeWidth": 2,
          "dash": [7, 4]
        },
        {
          "type": "rect",
          "x": 0,
          "y": 0,
          "width": 28,
          "height": "100%",
          "fill": "#ffe3e3",
          "stroke": "#e03131",
          "strokeWidth": 2
        },
        {
          "type": "text",
          "x": -66,
          "y": "50% - 14",
          "width": 160,
          "height": 28,
          "text": "= Name",
          "wrap": true,
          "fit": "shrink",
          "align": "center",
          "valign": "middle",
          "fill": "#1b1f27",
          "font": {
            "weight": 600
          },
          "transform": {
            "rotate": -90
          }
        }
      ],
      "look": {
        "base": "swimlane",
        "fill": "#ffe3e3",
        "border": "#e03131",
        "borderWidth": 2,
        "borderStyle": "dashed",
        "title": {
          "attribute": "Name",
          "bold": true
        },
        "size": {
          "width": 760,
          "height": 400,
          "resizable": true
        }
      }
    },
    "shp_process": {
      "id": "shp_process",
      "name": "Process look",
      "kind": "node",
      "size": {
        "width": 160,
        "height": 100,
        "resizable": true,
        "minWidth": 40,
        "minHeight": 28
      },
      "outline": "ellipse",
      "parts": [
        {
          "type": "ellipse",
          "x": 0,
          "y": 0,
          "width": "100%",
          "height": "100%",
          "fill": "#d0ebff",
          "stroke": "#1c7ed6",
          "strokeWidth": 1.5
        },
        {
          "type": "text",
          "x": "15%",
          "y": "15%",
          "width": "70%",
          "height": "70% - 20",
          "text": "= Name",
          "wrap": true,
          "fit": "shrink",
          "align": "center",
          "valign": "middle",
          "fill": "#1b1f27",
          "font": {
            "weight": 600
          }
        },
        {
          "type": "text",
          "x": "15%",
          "y": "85% - 18",
          "width": "70%",
          "height": 18,
          "text": "= Technology",
          "wrap": true,
          "fit": "shrink",
          "align": "center",
          "valign": "middle",
          "fill": "#3a4252",
          "font": {
            "size": 11
          }
        }
      ],
      "look": {
        "base": "circle",
        "fill": "#d0ebff",
        "border": "#1c7ed6",
        "borderWidth": 1.5,
        "borderStyle": "solid",
        "title": {
          "attribute": "Name",
          "bold": true
        },
        "size": {
          "width": 160,
          "height": 100,
          "resizable": true
        },
        "subtitle": {
          "attribute": "Technology"
        }
      }
    },
    "shp_datastore": {
      "id": "shp_datastore",
      "name": "DataStore look",
      "kind": "node",
      "size": {
        "width": 160,
        "height": 70,
        "resizable": true,
        "minWidth": 40,
        "minHeight": 28
      },
      "outline": "rect",
      "parts": [
        {
          "type": "rect",
          "x": 0,
          "y": 0,
          "width": "100%",
          "height": "100%",
          "radius": 0,
          "fill": "#e7f5ff",
          "stroke": "#1c7ed6",
          "strokeWidth": 1.5
        },
        {
          "type": "text",
          "x": 34,
          "y": 4,

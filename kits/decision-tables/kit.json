    "shp_businessknowledgemodel": {
      "id": "shp_businessknowledgemodel",
      "name": "BusinessKnowledgeModel look",
      "kind": "node",
      "size": {
        "width": 200,
        "height": 80,
        "resizable": true,
        "minWidth": 40,
        "minHeight": 28
      },
      "outline": {
        "type": "polygon",
        "points": [
          ["15%", 0],
          ["85%", 0],
          ["100%", "50%"],
          ["85%", "100%"],
          ["15%", "100%"],
          [0, "50%"]
        ]
      },
      "parts": [
        {
          "type": "polygon",

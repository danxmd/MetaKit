{
  "formatVersion": 7,
  "manifest": {
    "id": "kit_decisiontables",
    "name": "Decision tables (DMN-style)",
    "version": "1.0.0",
    "languages": ["en"]
  },
  "settings": {
    "grid": {
      "size": 10,
      "snap": true,
      "visible": true
    },
    "layers": [],
    "numbering": {
      "enabled": false,
      "prefix": "",
      "start": 1
    }
  },
  "classes": {
    "cls_note": {
      "id": "cls_note",
      "key": "Note",
      "kind": "node",
      "labels": {
        "en": "Note"
      },
      "help": {
        "en": "A free note on a diagram, for comments and explanations."
      },
      "attributes": [
        {
          "type": "text",
          "key": "Name",
          "required": true,
          "default": "Note",
          "id": "att_note_name",
          "labels": {
            "en": "Name"
          }
        },
        {
          "type": "text",
          "key": "Description",
          "multiline": true,
          "id": "att_note_description",
          "labels": {
            "en": "Description"
          }
        },
        {
          "type": "text",
          "key": "Text",
          "multiline": true,
          "id": "att_note_text",
          "labels": {
            "en": "Text"
          }
        }
      ],
      "shape": "shp_note"
    },
    "cls_decision": {
      "id": "cls_decision",
      "key": "Decision",
      "kind": "node",
      "labels": {
        "en": "Decision"
      },
      "help": {
        "en": "A question that is answered the same way every time, from the inputs it needs. Its logic is a decision table: one row per rule, with conditions and an outcome."
      },
      "attributes": [
        {
          "type": "text",
          "key": "Name",
          "required": true,
          "default": "Decision",
          "id": "att_decision_name",
          "labels": {
            "en": "Name"
          }
        },
        {
          "type": "text",
          "key": "Question",
          "multiline": true,
          "id": "att_decision_question",
          "labels": {
            "en": "Question"
          },
          "help": {
            "en": "The question it answers, such as \"Which risk category does the applicant fall into?\"."
          }
        },
        {
          "type": "text",
          "key": "Output",
          "id": "att_decision_output",
          "labels": {
            "en": "Output"
          },
          "help": {
            "en": "What it decides, such as \"Risk category\"."
          }
        },
        {
          "type": "text",
          "key": "AllowedOutcomes",
          "id": "att_decision_allowedoutcomes",
          "labels": {
            "en": "Allowed outcomes"
          },
          "help": {
            "en": "The answers it can give, such as \"Low, Medium, High\"."
          }
        },
        {
          "type": "choice",
          "key": "Logic",
          "options": ["Decision table", "Expression", "Manual"],
          "default": "Decision table",
          "id": "att_decision_logic",
          "labels": {
            "en": "Logic"
          },
          "help": {
            "en": "How the answer is found: by a table of rules, by one expression, or by a person."
          }
        },
        {
          "type": "choice",
          "key": "HitPolicy",
          "options": [
            "Unique",
            "First",
            "Priority",
            "Any",
            "Collect",
            "Rule order"
          ],
          "id": "att_decision_hitpolicy",
          "labels": {
            "en": "Hit policy"
          },
          "help": {
            "en": "What happens when more than one rule matches. Unique: rules never overlap. First: the first match wins. Priority: the match with the highest outcome wins. Any: all matches give the same outcome. Collect: all outcomes are returned. Rule order: all outcomes, in the order of the rules."
          }
        },
        {
          "type": "table",
          "key": "DecisionTable",
          "columns": [
            {
              "id": "conditions",
              "key": "Conditions",
              "type": "text",
              "labels": {
                "en": "Conditions"
              }
            },
            {
              "id": "outcome",
              "key": "Outcome",
              "type": "text",
              "labels": {
                "en": "Outcome"
              }
            },
            {
              "id": "annotation",
              "key": "Annotation",
              "type": "text",
              "labels": {
                "en": "Annotation"
              }
            }
          ],
          "id": "att_decision_decisiontable",
          "labels": {
            "en": "Rules"
          },
          "help": {
            "en": "One row per rule. Write the conditions on the inputs, such as \"Credit score >= 700 and Years trading >= 3\", and the outcome when they hold."
          }
        },
        {
          "type": "text",
          "key": "Owner",
          "id": "att_decision_owner",
          "labels": {
            "en": "Owner"
          }
        },
        {
          "type": "choice",
          "key": "Status",
          "options": ["Draft", "In review", "Approved", "Retired"],
          "id": "att_decision_status",
          "labels": {
            "en": "Status"
          }
        },
        {
          "type": "formula",
          "key": "Rules",
          "formula": "len(DecisionTable)",
          "result": "number",
          "id": "att_decision_rules",
          "labels": {
            "en": "Rules"
          },
          "help": {
            "en": "How many rules its table has."
          }
        },
        {
          "type": "formula",
          "key": "Inputs",
          "formula": "count(incoming('InformationRequirement'))",
          "result": "number",
          "id": "att_decision_inputs",
          "labels": {
            "en": "Inputs"
          },
          "help": {
            "en": "How many input data and decisions it needs."
          }
        }
      ],
      "constraints": [
        {
          "id": "k_decision_inputs",
          "formula": "Inputs > 0",
          "message": "= 'Decision \"' + Name + '\" has no inputs: connect the input data or decisions it needs with \"Information requirement\".'",
          "severity": "warning"
        },
        {
          "id": "k_decision_rules",
          "formula": "Logic != 'Decision table' || Rules > 0",
          "message": "= 'Decision \"' + Name + '\" is a decision table without rules: add one row per rule.'",
          "severity": "warning"
        },
        {
          "id": "k_decision_policy",
          "formula": "Logic != 'Decision table' || HitPolicy != null",
          "message": "= 'Decision \"' + Name + '\" has no hit policy: say what happens when more than one rule matches.'",
          "severity": "warning"
        }
      ],
      "shape": "shp_decision"
    },
    "cls_inputdata": {
      "id": "cls_inputdata",
      "key": "InputData",
      "kind": "node",
      "labels": {
        "en": "Input data"
      },
      "help": {
        "en": "A piece of information a decision needs, such as the amount of a loan."
      },
      "attributes": [
        {
          "type": "text",
          "key": "Name",
          "required": true,
          "default": "Input data",
          "id": "att_inputdata_name",
          "labels": {
            "en": "Name"
          }
        },
        {
          "type": "text",
          "key": "Description",
          "multiline": true,
          "id": "att_inputdata_description",
          "labels": {
            "en": "Description"
          }
        },
        {
          "type": "choice",
          "key": "DataType",
          "options": ["Text", "Number", "Yes or no", "Date", "List"],
          "id": "att_inputdata_datatype",
          "labels": {
            "en": "Data type"
          }
        },
        {
          "type": "text",
          "key": "AllowedValues",
          "id": "att_inputdata_allowedvalues",
          "labels": {
            "en": "Allowed values"
          },
          "help": {
            "en": "The values it can take, such as \"0 to 999\" or \"Yes, No\"."
          }
        },
        {
          "type": "text",
          "key": "Source",
          "id": "att_inputdata_source",
          "labels": {
            "en": "Source"
          },
          "help": {
            "en": "Where the value comes from."
          }
        }
      ],
      "constraints": [
        {
          "id": "k_input_used",
          "formula": "count(outgoing('InformationRequirement')) > 0",
          "message": "= 'Input data \"' + Name + '\" is not used by any decision.'",
          "severity": "warning"
        }
      ],
      "shape": "shp_inputdata"
    },
    "cls_businessknowledgemodel": {
      "id": "cls_businessknowledgemodel",
      "key": "BusinessKnowledgeModel",
      "kind": "node",
      "labels": {
        "en": "Business knowledge model"
      },
      "help": {
        "en": "Logic that can be reused by several decisions, such as a calculation or a scoring table."
      },
      "attributes": [
        {
          "type": "text",
          "key": "Name",
          "required": true,
          "default": "Business knowledge model",
          "id": "att_businessknowledgemodel_name",
          "labels": {
            "en": "Name"
          }
        },
        {
          "type": "text",
          "key": "Description",
          "multiline": true,
          "id": "att_businessknowledgemodel_description",
          "labels": {
            "en": "Description"
          }
        },
        {
          "type": "text",
          "key": "Parameters",
          "id": "att_businessknowledgemodel_parameters",
          "labels": {
            "en": "Parameters"
          },
          "help": {
            "en": "The values it takes, such as \"amount, rate, months\"."
          }
        },
        {
          "type": "text",
          "key": "Logic",
          "multiline": true,
          "id": "att_businessknowledgemodel_logic",
          "labels": {
            "en": "Logic"
          },
          "help": {
            "en": "The calculation or rules it applies."
          }
        }
      ],
      "shape": "shp_businessknowledgemodel"
    },
    "cls_knowledgesource": {
      "id": "cls_knowledgesource",
      "key": "KnowledgeSource",
      "kind": "node",
      "labels": {
        "en": "Knowledge source"
      },
      "help": {
        "en": "Where the logic of a decision comes from or who answers for it, such as a policy, a regulation or a team of experts."
      },
      "attributes": [
        {
          "type": "text",
          "key": "Name",
          "required": true,
          "default": "Knowledge source",
          "id": "att_knowledgesource_name",
          "labels": {
            "en": "Name"
          }
        },
        {
          "type": "text",
          "key": "Description",
          "multiline": true,
          "id": "att_knowledgesource_description",
          "labels": {
            "en": "Description"
          }
        },
        {
          "type": "choice",
          "key": "Kind",
          "options": [
            "Policy",
            "Regulation",
            "Guideline",
            "Expert",
            "Analysis"
          ],
          "id": "att_knowledgesource_kind",
          "labels": {
            "en": "Kind"
          }
        },
        {
          "type": "text",
          "key": "Owner",
          "id": "att_knowledgesource_owner",
          "labels": {
            "en": "Owner"
          }
        },
        {
          "type": "text",
          "key": "Reference",
          "id": "att_knowledgesource_reference",
          "labels": {
            "en": "Reference"
          },
          "help": {
            "en": "Where to find it, such as a link."
          }
        }
      ],
      "shape": "shp_knowledgesource"
    }
  },
  "relations": {
    "rel_informationrequirement": {
      "id": "rel_informationrequirement",
      "key": "InformationRequirement",
      "labels": {
        "en": "Information requirement"
      },
      "help": {
        "en": "The decision needs this input data, or the outcome of this other decision."
      },
      "from": ["cls_inputdata", "cls_decision"],
      "to": ["cls_decision"],
      "attributes": [],
      "shape": "shp_rel_informationrequirement"
    },
    "rel_knowledgerequirement": {
      "id": "rel_knowledgerequirement",
      "key": "KnowledgeRequirement",
      "labels": {
        "en": "Knowledge requirement"
      },
      "help": {
        "en": "The decision or business knowledge model uses the logic of this business knowledge model."
      },
      "from": ["cls_businessknowledgemodel"],
      "to": ["cls_decision", "cls_businessknowledgemodel"],
      "attributes": [],
      "shape": "shp_rel_knowledgerequirement"
    },
    "rel_authorityrequirement": {
      "id": "rel_authorityrequirement",
      "key": "AuthorityRequirement",
      "labels": {
        "en": "Authority requirement"
      },
      "help": {
        "en": "The knowledge source is the authority for the decision, business knowledge model or other knowledge source."
      },
      "from": ["cls_knowledgesource", "cls_inputdata"],
      "to": [
        "cls_decision",
        "cls_businessknowledgemodel",
        "cls_knowledgesource"
      ],
      "attributes": [],
      "shape": "shp_rel_authorityrequirement"
    },
    "rel_annotates": {
      "id": "rel_annotates",
      "key": "Annotates",
      "labels": {
        "en": "Annotates"
      },
      "help": {
        "en": "The note explains the object it points to."
      },
      "from": ["cls_note"],
      "to": [
        "cls_decision",
        "cls_inputdata",
        "cls_businessknowledgemodel",
        "cls_knowledgesource"
      ],
      "attributes": [],
      "shape": "shp_rel_annotates"
    }
  },
  "modelTypes": {
    "mt_decisionmodel": {
      "id": "mt_decisionmodel",
      "key": "DecisionModel",
      "labels": {
        "en": "Decision requirements"
      },
      "classes": [
        "cls_note",
        "cls_decision",
        "cls_inputdata",
        "cls_businessknowledgemodel",
        "cls_knowledgesource"
      ],
      "relations": [
        "rel_informationrequirement",
        "rel_knowledgerequirement",
        "rel_authorityrequirement",
        "rel_annotates"
      ],
      "views": [
        {
          "id": "vw_requirements",
          "key": "Requirements",
          "labels": {
            "en": "Requirements only"
          },
          "classes": ["cls_decision", "cls_inputdata"],
          "relations": ["rel_informationrequirement"]
        }
      ],
      "cardinalities": [
        {
          "kind": "count",
          "class": "cls_decision",
          "min": 1
        }
      ],
      "attributes": [
        {
          "type": "text",
          "key": "Title",
          "required": true,
          "maxLength": 100,
          "id": "att_mtdecisionmodel_title",
          "labels": {
            "en": "Title"
          }
        },
        {
          "type": "text",
          "key": "Domain",
          "id": "att_mtdecisionmodel_domain",
          "labels": {
            "en": "Domain"
          },
          "help": {
            "en": "The area of the business, such as lending."
          }
        },
        {
          "type": "text",
          "key": "Owner",
          "id": "att_mtdecisionmodel_owner",
          "labels": {
            "en": "Owner"
          }
        },
        {
          "type": "formula",
          "key": "Decisions",
          "formula": "count(objects('Decision'))",
          "result": "number",
          "id": "att_mtdecisionmodel_decisions",
          "labels": {
            "en": "Decisions"
          },
          "help": {
            "en": "How many decisions the model has."
          }
        },
        {
          "type": "formula",
          "key": "TotalRules",
          "formula": "sum(objects('Decision').Rules)",
          "result": "number",
          "id": "att_mtdecisionmodel_totalrules",
          "labels": {
            "en": "Total rules"
          },
          "help": {
            "en": "The rules of all decision tables added up."
          }
        }
      ],
      "help": {
        "en": "Decisions with their decision tables, the input data and decisions they need, the business knowledge models they use and the knowledge sources behind them."
      }
    }
  },

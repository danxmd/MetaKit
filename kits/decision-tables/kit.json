          "text": "= Name",
          "wrap": true,
          "fit": "shrink",
          "align": "center",
          "valign": "middle",
          "fill": "#1b1f27",
          "font": {
            "weight": 600
          }
        }
      ],
      "look": {
        "base": "document",
        "fill": "#ffec99",
        "border": "#f2c200",

{
  "formatVersion": 7,
  "manifest": {
    "id": "tool_erlite",
    "name": "ER lite",
    "version": "1.0.0",
    "languages": ["en"]
  },
  "settings": {
    "grid": {
      "size": 20,
      "snap": true,
      "visible": false
    },
    "layers": [],
    "numbering": {
      "enabled": false,
      "prefix": "",
      "start": 1
    }
  },
  "classes": {
    "cls_entity": {
      "id": "cls_entity",
      "key": "Entity",
      "kind": "node",
      "labels": {
        "en": "Entity"
      },
      "attributes": [
        {
          "id": "att_ename",
          "key": "Name",
          "type": "text",
          "required": true,
          "maxLength": 60,
          "pattern": "^[A-Z][A-Za-z0-9 ]*$"
        },
        {
          "id": "att_edescription",
          "key": "Description",
          "type": "text",
          "multiline": true
        }
      ],
      "shape": "shp_er_entity"
    },
    "cls_attribute": {
      "id": "cls_attribute",
      "key": "Attribute",
      "kind": "node",
      "labels": {
        "en": "Attribute"
      },
      "attributes": [
        {
          "id": "att_aname",
          "key": "Name",
          "type": "text",
          "required": true,
          "maxLength": 60
        },
        {
          "id": "att_datatype",
          "key": "DataType",
          "type": "choice",
          "options": ["text", "number", "date", "boolean"],
          "default": "text"
        },
        {
          "id": "att_iskey",
          "key": "IsKey",
          "type": "boolean",
          "default": false
        }
      ],
      "shape": "shp_er_attribute"
    },
    "cls_relationship": {
      "id": "cls_relationship",
      "key": "Relationship",
      "kind": "node",
      "labels": {
        "en": "Relationship"
      },
      "attributes": [
        {
          "id": "att_rname",
          "key": "Name",
          "type": "text",
          "required": true,
          "maxLength": 60
        }
      ],
      "shape": "shp_er_relationship"
    }
  },
  "relations": {
    "rel_has": {
      "id": "rel_has",
      "key": "Has",
      "labels": {
        "en": "Has"
      },
      "from": ["cls_entity", "cls_relationship"],
      "to": ["cls_attribute"],
      "attributes": [],
      "shape": "shp_flow"
    },
    "rel_participates": {
      "id": "rel_participates",
      "key": "Participates",
      "labels": {
        "en": "Participates in"
      },
      "from": ["cls_entity"],
      "to": ["cls_relationship"],
      "attributes": [
        {
          "id": "att_cardinality",
          "key": "Cardinality",
          "type": "choice",
          "options": ["1", "N"],
          "default": "N"
        }
      ],
      "shape": "shp_er_participates"
    }
  },
  "modelTypes": {
    "mt_er": {
      "id": "mt_er",
      "key": "ERDiagram",
      "labels": {
        "en": "ER diagram"
      },
      "classes": ["cls_entity", "cls_attribute", "cls_relationship"],
      "relations": ["rel_has", "rel_participates"],
      "views": [],
      "cardinalities": [
        {
          "kind": "count",
          "class": "cls_entity",
          "min": 1
        },
        {
          "kind": "degree",
          "class": "cls_attribute",
          "relation": "rel_has",
          "end": "to",
          "min": 1,
          "max": 1
        },
        {
          "kind": "degree",
          "class": "cls_relationship",
          "relation": "rel_participates",
          "end": "to",
          "min": 2
        }
      ],
      "attributes": [
        {
          "id": "att_ertitle",
          "key": "Title",
          "type": "text",
          "required": true
        },
        {
          "id": "att_erauthor",
          "key": "Author",
          "type": "text"
        }
      ]
    }
  },
  "shapes": {
    "shp_er_entity": {
      "id": "shp_er_entity",
      "name": "Entity (box with header)",
      "kind": "node",
      "size": {
        "width": 150,
        "height": 100,
        "resizable": true,
        "minWidth": 40,
        "minHeight": 28
      },
      "outline": "rect",
      "parts": [
        {
          "type": "rect",
          "x": 0,
          "y": 0,
          "width": "100%",
          "height": "100%",
          "radius": 2,
          "fill": "#ffffff",
          "stroke": "#364fc7",
          "strokeWidth": 2
        },
        {
          "type": "rect",
          "x": 0,
          "y": 0,
          "width": "100%",
          "height": 28,
          "radius": 2,
          "fill": "#364fc7",
          "stroke": "#364fc7"
        },
        {
          "type": "text",
          "x": 8,
          "y": 2,
          "width": "100% - 36",
          "height": 24,
          "text": "= $label",
          "wrap": true,
          "fit": "shrink",
          "align": "center",
          "valign": "middle",
          "fill": "#ffffff",
          "font": {
            "weight": 600
          }
        },
        {
          "type": "text",
          "x": 8,
          "y": 34,
          "width": "100% - 16",
          "height": 16,
          "text": "= 'Description: ' + Description",
          "wrap": true,
          "fit": "shrink",
          "align": "left",
          "valign": "middle",
          "fill": "#5a6373",
          "font": {
            "size": 11
          }
        }
      ],
      "look": {
        "base": "header-box",
        "fill": "#364fc7",
        "border": "#364fc7",
        "borderWidth": 2,
        "borderStyle": "solid",
        "corner": 2,
        "title": {
          "attribute": null,
          "bold": true
        },
        "fields": ["Description"],
        "size": {
          "width": 150,
          "height": 100,
          "resizable": true
        }
      }
    },
    "shp_flow": {
      "id": "shp_flow",
      "name": "Has (line)",
      "kind": "relation",
      "line": {
        "stroke": "#6b7a90",
        "strokeWidth": 1.5,
        "routing": "straight"
      },
      "look": {
        "colour": "#6b7a90",
        "width": 1.5,
        "style": "solid",
        "routing": "straight",
        "start": "none",
        "end": "none",
        "label": null
      }
    },
    "shp_er_attribute": {
      "id": "shp_er_attribute",
      "name": "Attribute (ellipse)",
      "kind": "node",
      "size": {
        "width": 120,
        "height": 50,
        "resizable": true,
        "minWidth": 40,
        "minHeight": 28
      },
      "outline": "ellipse",
      "parts": [
        {
          "type": "ellipse",
          "x": 0,
          "y": 0,
          "width": "100%",
          "height": "100%",
          "fill": "= IsKey == true ? '#ffec99' : '#f8f9fa'",
          "stroke": "= IsKey == true ? '#e67700' : '#364fc7'",
          "strokeWidth": 1.5
        },
        {
          "type": "text",
          "x": "15%",
          "y": "15%",
          "width": "70%",
          "height": "70%",
          "text": "= $label",
          "wrap": true,
          "fit": "shrink",
          "align": "center",
          "valign": "middle",
          "fill": "#1b1f27",
          "font": {}
        }
      ],
      "look": {
        "base": "circle",
        "fill": {
          "by": "IsKey",
          "values": {
            "true": "#ffec99"
          },
          "fallback": "#f8f9fa"
        },
        "border": {
          "by": "IsKey",
          "values": {
            "true": "#e67700"
          },
          "fallback": "#364fc7"
        },
        "borderWidth": 1.5,
        "borderStyle": "solid",
        "title": {
          "attribute": null
        },
        "size": {
          "width": 120,
          "height": 50,
          "resizable": true
        }
      }
    },
    "shp_er_relationship": {
      "id": "shp_er_relationship",
      "name": "Relationship (diamond)",
      "kind": "node",
      "size": {
        "width": 120,
        "height": 70,
        "resizable": true,
        "minWidth": 40,
        "minHeight": 28
      },
      "outline": {
        "type": "polygon",
        "points": [
          ["50%", 0],
          ["100%", "50%"],
          ["50%", "100%"],
          [0, "50%"]
        ]
      },
      "parts": [
        {
          "type": "polygon",
          "points": [
            ["50%", 0],
            ["100%", "50%"],
            ["50%", "100%"],
            [0, "50%"]
          ],
          "fill": "#e5dbff",
          "stroke": "#7048e8",
          "strokeWidth": 1.5
        },
        {
          "type": "text",
          "x": "24%",
          "y": "24%",
          "width": "52%",
          "height": "52%",
          "text": "= $label",
          "wrap": true,
          "fit": "shrink",
          "align": "center",
          "valign": "middle",
          "fill": "#1b1f27",
          "font": {}
        }
      ],
      "look": {
        "base": "diamond",
        "fill": "#e5dbff",
        "border": "#7048e8",
        "borderWidth": 1.5,
        "borderStyle": "solid",
        "title": {
          "attribute": null
        },
        "size": {
          "width": 120,
          "height": 70,
          "resizable": true
        }
      }
    },
    "shp_er_participates": {
      "id": "shp_er_participates",
      "name": "Participates in (line with cardinality)",
      "kind": "relation",
      "line": {
        "stroke": "#7048e8",
        "strokeWidth": 1.5,
        "routing": "straight"
      },
      "labels": [
        {
          "at": "middle",
          "text": "= Cardinality",
          "font": {
            "size": 11
          },
          "background": "#ffffff",
          "visible": "= Cardinality != null"
        }
      ],
      "look": {
        "colour": "#7048e8",
        "width": 1.5,
        "style": "solid",
        "routing": "straight",
        "start": "none",
        "end": "none",
        "label": {
          "attribute": "Cardinality"
        }
      }
    }
  },
  "panels": {},
  "rules": {},
  "scripts": {}
}

              "attribute": "Likelihood"
            },
            {
              "attribute": "Impact"
            },
            {
              "attribute": "Score"
            },
            {
              "attribute": "Rating"
            },
            {
              "attribute": "Description",
              "control": "textarea"
            }
          ]
        }
      ],
      "showRelations": true
    }
  },
  "rules": {
    "rule_approve": {
      "id": "rule_approve",
      "label": "Mark approved",
      "when": {
        "event": "command"
      },
      "if": "= Status == 'Assessed'",
      "then": [
        {
          "action": "setAttribute",
          "attribute": "Status",
          "value": "Approved",
          "target": "self"
        }
      ],
      "command": {
        "label": "Mark approved",
        "place": "toolbar"
      }
    },
    "rule_deliver": {
      "id": "rule_deliver",
      "label": "Start delivery",
      "when": {
        "event": "command"
      },
      "if": "= Status == 'Approved'",
      "then": [
        {
          "action": "setAttribute",
          "attribute": "Status",
          "value": "In delivery",
          "target": "self"
        }
      ],
      "command": {
        "label": "Start delivery",
        "place": "context"
      }
    },
    "rule_value": {
      "id": "rule_value",
      "label": "Portfolio value",
      "when": {
        "event": "command"
      },
      "then": [
        {
          "action": "message",
          "kind": "info",
          "text": "= count(objects('UseCase')) + ' use cases, estimated at $' + sum(objects('UseCase').EstimatedAnnualValue) + ' a year for ' + sum(objects('UseCase').Effort) + ' person-weeks of effort.'"
        }
      ],
      "command": {
        "label": "Portfolio value",
        "place": "model"
      }
    },
    "rule_high_risk": {
      "id": "rule_high_risk",
      "label": "High risk needs a mitigation",
      "when": {
        "event": "attribute.changed",
        "class": "cls_usecase",
        "attribute": "RiskLevel"
      },
      "if": "= RiskLevel == 'High' && trim(Mitigation ?? '') == ''",
      "then": [
        {
          "action": "message",
          "kind": "warning",
          "text": "= Name + ' is high risk now. Describe how the risk is mitigated on the Delivery tab.'"
        }
      ]
    }
  },
  "scripts": {
    "scr_rank": {
      "id": "scr_rank",
      "name": "Rank use cases",
      "source": "// For the tool \"AI use-case portfolio\". The command \"Rank use cases\" lists the use cases from the\n// highest priority score down, with their quadrant and status, and counts them per quadrant.\n// Sorting and counting need a loop, which is why this is a script and not a rule.\nimport { commands, model, ui } from 'metakit';\n\nconst QUADRANTS = ['Quick win', 'Strategic bet', 'Fill-in', 'Deprioritise'];\nconst TOP = 10;\n\ncommands.register({\n  id: 'rank-use-cases',\n  label: 'Rank use cases',\n  menu: 'Model',\n  run: () => {\n    const useCases = model.objects('UseCase').map((u) => ({\n      name: u.attrs.Name || 'Unnamed use case',\n      score: u.attrs.PriorityScore,\n      quadrant: u.attrs.Quadrant,\n      status: u.attrs.Status ?? 'no status',\n    }));\n    if (useCases.length === 0) {\n      ui.message('There are no use cases in this model yet.');\n      return;\n    }\n\n    // Use cases without a score go last; equal scores keep their names in order.\n    useCases.sort(\n      (a, b) =>\n        (typeof b.score === 'number' ? b.score : -1) -\n          (typeof a.score === 'number' ? a.score : -1) ||\n        a.name.localeCompare(b.name),\n    );\n\n    const lines = useCases\n      .slice(0, TOP)\n      .map(\n        (u, i) =>\n          `${i + 1}. ${u.name}: ${typeof u.score === 'number' ? u.score : 'not scored'} (${u.quadrant || 'no quadrant'}, ${u.status})`,\n      );\n    const counts = QUADRANTS.map(\n      (q) => `${q}: ${useCases.filter((u) => u.quadrant === q).length}`,\n    );\n    const shown =\n      useCases.length > TOP\n        ? `Top ${TOP} of ${useCases.length} use cases`\n        : `${useCases.length} use cases`;\n    ui.message(\n      `${shown}, by priority score:\\n${lines.join('\\n')}\\n\\nPer quadrant: ${counts.join(', ')}.`,\n    );\n  },\n});\n"
    }
  }
}

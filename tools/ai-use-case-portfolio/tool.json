{
  "formatVersion": 6,
  "manifest": {
    "id": "tool_aiportfolio",
    "name": "AI use-case portfolio",
    "version": "1.0.0",
    "languages": ["en"]
  },
  "settings": {
    "grid": {
      "size": 10,
      "snap": true,
      "visible": true
    },
    "layers": [
      {
        "key": "main",
        "labels": {
          "en": "Main"
        },
        "visible": true
      }
    ],
    "numbering": {
      "enabled": false,
      "prefix": "",
      "start": 1
    }
  },
  "classes": {
    "cls_usecase": {
      "id": "cls_usecase",
      "key": "UseCase",
      "kind": "node",
      "labels": {
        "en": "Use case"
      },
      "attributes": [
        {
          "id": "att_ucname",
          "key": "Name",
          "type": "text",
          "labels": {
            "en": "Name"
          },
          "required": true,
          "maxLength": 100,
          "default": "New use case"
        },
        {
          "id": "att_ucdesc",
          "key": "Description",
          "type": "text",
          "labels": {
            "en": "Description"
          },
          "multiline": true
        },
        {
          "id": "att_ucproblem",
          "key": "Problem",
          "type": "text",
          "labels": {
            "en": "Problem it solves"
          },
          "multiline": true
        },
        {
          "id": "att_ucstatus",
          "key": "Status",
          "type": "choice",
          "labels": {
            "en": "Status"
          },
          "options": [
            "Idea",
            "Assessed",
            "Approved",
            "In delivery",
            "Live",
            "Stopped"
          ],
          "default": "Idea"
        },
        {
          "id": "att_ucvalue",
          "key": "Value",
          "type": "integer",
          "labels": {
            "en": "Value"
          },
          "help": {
            "en": "Business value if it works, from 1 (little) to 5 (very high)."
          },
          "min": 1,
          "max": 5,
          "default": 3,
          "group": "Scoring"
        },
        {
          "id": "att_ucfeas",
          "key": "Feasibility",
          "type": "integer",
          "labels": {
            "en": "Feasibility"
          },
          "help": {
            "en": "How easy it is to build and run, from 1 (very hard) to 5 (easy)."
          },
          "min": 1,
          "max": 5,
          "default": 3,
          "group": "Scoring"
        },
        {
          "id": "att_ucdata",
          "key": "DataReadiness",
          "type": "integer",
          "labels": {
            "en": "Data readiness"
          },
          "help": {
            "en": "Whether the data it needs exists, is good enough and may be used, from 1 (not at all) to 5 (ready)."
          },
          "min": 1,
          "max": 5,
          "default": 3,
          "group": "Scoring"
        },
        {
          "id": "att_ucrisk",
          "key": "RiskLevel",
          "type": "choice",
          "labels": {
            "en": "Risk level"
          },
          "options": ["Low", "Medium", "High"],
          "default": "Medium",
          "group": "Scoring"
        },
        {
          "id": "att_ucscore",
          "key": "PriorityScore",
          "type": "formula",
          "labels": {
            "en": "Priority score"
          },
          "help": {
            "en": "From 20 to 100: value counts 40%, feasibility and data readiness 30% each."
          },
          "group": "Scoring",
          "formula": "IF(Value == null || Feasibility == null || DataReadiness == null, null, round(round(Value * 0.4 + Feasibility * 0.3 + DataReadiness * 0.3, 1) * 20))",
          "result": "number"
        },
        {
          "id": "att_ucquadrant",
          "key": "Quadrant",
          "type": "formula",
          "labels": {
            "en": "Quadrant"
          },
          "help": {
            "en": "Quick win: value and feasibility 3 or more. Strategic bet: high value, hard to do. Fill-in: easy, lower value. Deprioritise: neither."
          },
          "group": "Scoring",
          "formula": "IF(Value == null || Feasibility == null, null, Value >= 3 ? (Feasibility >= 3 ? 'Quick win' : 'Strategic bet') : (Feasibility >= 3 ? 'Fill-in' : 'Deprioritise'))",
          "result": "text"
        },
        {
          "id": "att_uceffort",
          "key": "Effort",
          "type": "number",
          "labels": {
            "en": "Effort"
          },
          "min": 0,
          "decimals": 1,
          "unit": "person-weeks",
          "group": "Delivery"
        },
        {
          "id": "att_ucannual",
          "key": "EstimatedAnnualValue",
          "type": "number",
          "labels": {
            "en": "Estimated annual value"
          },
          "min": 0,
          "decimals": 0,
          "unit": "$",
          "group": "Delivery"
        },
        {
          "id": "att_ucmitig",
          "key": "Mitigation",
          "type": "text",
          "labels": {
            "en": "Mitigation"
          },
          "multiline": true,
          "group": "Delivery",
          "help": {
            "en": "How the risks of this use case are kept under control."
          }
        }
      ],
      "constraints": [
        {
          "id": "k_high_risk_mitigation",
          "formula": "RiskLevel != 'High' || trim(Mitigation ?? '') != ''",
          "message": "A high-risk use case needs a mitigation.",
          "severity": "warning"
        },
        {
          "id": "k_approved_sponsor",
          "formula": "(Status != 'Approved' && Status != 'In delivery' && Status != 'Live') || count(incoming('Sponsors')) > 0",
          "message": "An approved, delivered or live use case needs a stakeholder who sponsors it.",
          "severity": "warning"
        }
      ],
      "help": {
        "en": "A way to use AI that the organisation considers, scored on value, feasibility, data readiness and risk."
      },
      "shape": "shp_usecase"
    },
    "cls_objective": {
      "id": "cls_objective",
      "key": "Objective",
      "kind": "node",
      "labels": {
        "en": "Objective"
      },
      "attributes": [
        {
          "id": "att_objname",
          "key": "Name",
          "type": "text",
          "labels": {
            "en": "Name"
          },
          "required": true,
          "maxLength": 100,
          "default": "New objective"
        },
        {
          "id": "att_objdesc",
          "key": "Description",
          "type": "text",
          "labels": {
            "en": "Description"
          },
          "multiline": true
        },
        {
          "id": "att_objhorizon",
          "key": "Horizon",
          "type": "choice",
          "labels": {
            "en": "Horizon"
          },
          "options": ["This year", "Next year", "Later"],
          "default": "This year"
        }
      ],
      "help": {
        "en": "A business goal that use cases contribute to."
      },
      "shape": "shp_objective"
    },
    "cls_kpi": {
      "id": "cls_kpi",
      "key": "KPI",
      "kind": "node",
      "labels": {
        "en": "KPI"
      },
      "attributes": [
        {
          "id": "att_kpiname",
          "key": "Name",
          "type": "text",
          "labels": {
            "en": "Name"
          },
          "required": true,
          "maxLength": 100,
          "default": "New KPI"
        },
        {
          "id": "att_kpiunit",
          "key": "Unit",
          "type": "text",
          "labels": {
            "en": "Unit"
          },
          "maxLength": 30
        },
        {
          "id": "att_kpitarget",
          "key": "Target",
          "type": "number",
          "labels": {
            "en": "Target"
          }
        },
        {
          "id": "att_kpicurrent",
          "key": "Current",
          "type": "number",
          "labels": {
            "en": "Current"
          }
        },
        {
          "id": "att_kpidir",
          "key": "Direction",
          "type": "choice",
          "labels": {
            "en": "Direction"
          },
          "options": ["Higher is better", "Lower is better"],
          "default": "Higher is better"
        },
        {
          "id": "att_kpiontrack",
          "key": "OnTrack",
          "type": "formula",
          "labels": {
            "en": "On track"
          },
          "help": {
            "en": "Whether the current value has reached the target, in the direction that counts. Empty while either is missing."
          },
          "formula": "IF(Target == null || Current == null, null, Direction == 'Lower is better' ? Current <= Target : Current >= Target)",
          "result": "boolean"
        }
      ],
      "help": {
        "en": "A measure that shows whether an objective or a use case works."
      },
      "shape": "shp_kpi"
    },
    "cls_stakeholder": {
      "id": "cls_stakeholder",
      "key": "Stakeholder",
      "kind": "node",
      "labels": {
        "en": "Stakeholder"
      },
      "attributes": [
        {
          "id": "att_shname",
          "key": "Name",
          "type": "text",
          "labels": {
            "en": "Name"
          },
          "required": true,
          "maxLength": 80,
          "default": "New stakeholder"
        },
        {
          "id": "att_shrole",
          "key": "Role",
          "type": "text",
          "labels": {
            "en": "Role"
          },
          "maxLength": 80
        },
        {
          "id": "att_shinterest",
          "key": "Interest",
          "type": "choice",
          "labels": {
            "en": "Interest"
          },
          "options": ["Low", "Medium", "High"],
          "default": "Medium"
        },
        {
          "id": "att_shinfluence",
          "key": "Influence",
          "type": "choice",
          "labels": {
            "en": "Influence"
          },
          "options": ["Low", "Medium", "High"],
          "default": "Medium"
        }
      ],
      "help": {
        "en": "A person or group with a stake in the portfolio."
      },
      "shape": "shp_stakeholder"
    },
    "cls_dataasset": {
      "id": "cls_dataasset",
      "key": "DataAsset",
      "kind": "node",
      "labels": {
        "en": "Data asset"
      },
      "attributes": [
        {
          "id": "att_daname",
          "key": "Name",
          "type": "text",
          "labels": {
            "en": "Name"
          },
          "required": true,
          "maxLength": 100,
          "default": "New data asset"
        },
        {
          "id": "att_daclass",
          "key": "Classification",
          "type": "choice",
          "labels": {
            "en": "Classification"
          },
          "options": ["Public", "Internal", "Confidential", "Restricted"],
          "default": "Internal"
        },
        {
          "id": "att_daready",
          "key": "Readiness",
          "type": "integer",
          "labels": {
            "en": "Readiness"
          },
          "help": {
            "en": "How ready the data is for AI use, from 1 (not available) to 5 (clean, documented and allowed)."
          },
          "min": 1,
          "max": 5,
          "default": 3
        },
        {
          "id": "att_daowner",
          "key": "Owner",
          "type": "text",
          "labels": {
            "en": "Owner"
          },
          "maxLength": 80
        }
      ],
      "help": {
        "en": "Data that a use case needs: a system, a dataset or a document collection."
      },
      "shape": "shp_dataasset"
    },
    "cls_technique": {
      "id": "cls_technique",
      "key": "AITechnique",
      "kind": "node",
      "labels": {
        "en": "AI technique"
      },
      "attributes": [
        {
          "id": "att_tqname",
          "key": "Name",
          "type": "text",
          "labels": {
            "en": "Name"
          },
          "required": true,
          "maxLength": 100,
          "default": "New technique"
        },
        {
          "id": "att_tqkind",
          "key": "Kind",
          "type": "choice",
          "labels": {
            "en": "Kind"
          },
          "options": [
            "Classification",
            "Forecasting",
            "Recommendation",
            "Generative text",
            "Document understanding",
            "Agentic workflow",
            "Optimisation",
            "Other"
          ],
          "default": "Classification"
        },
        {
          "id": "att_tqnotes",
          "key": "Notes",
          "type": "text",
          "labels": {
            "en": "Notes"
          },
          "multiline": true
        }
      ],
      "help": {
        "en": "The kind of AI a use case relies on."
      },
      "shape": "shp_technique"
    },
    "cls_risk": {
      "id": "cls_risk",
      "key": "Risk",
      "kind": "node",
      "labels": {
        "en": "Risk"
      },
      "attributes": [
        {
          "id": "att_rkname",
          "key": "Name",
          "type": "text",
          "labels": {
            "en": "Name"
          },
          "required": true,
          "maxLength": 100,
          "default": "New risk"
        },
        {
          "id": "att_rkkind",
          "key": "Kind",
          "type": "choice",
          "labels": {
            "en": "Kind"
          },
          "options": [
            "Bias",
            "Privacy",
            "Security",
            "Regulatory",
            "Accuracy",
            "Adoption"
          ],
          "default": "Accuracy"
        },
        {
          "id": "att_rklike",
          "key": "Likelihood",
          "type": "integer",
          "labels": {
            "en": "Likelihood"
          },
          "min": 1,
          "max": 5,
          "default": 3
        },
        {
          "id": "att_rkimpact",
          "key": "Impact",
          "type": "integer",
          "labels": {
            "en": "Impact"
          },
          "min": 1,
          "max": 5,
          "default": 3
        },
        {
          "id": "att_rkscore",
          "key": "Score",
          "type": "formula",
          "labels": {
            "en": "Score"
          },
          "help": {
            "en": "Likelihood times impact, from 1 to 25."
          },
          "formula": "IF(Likelihood == null || Impact == null, null, Likelihood * Impact)",
          "result": "number"
        },
        {
          "id": "att_rkrating",
          "key": "Rating",
          "type": "formula",
          "labels": {
            "en": "Rating"
          },
          "help": {
            "en": "Low up to 6, Medium up to 14, High from 15."
          },
          "formula": "IF(Score == null, null, Score >= 15 ? 'High' : Score >= 7 ? 'Medium' : 'Low')",
          "result": "text"
        },
        {
          "id": "att_rkdesc",
          "key": "Description",
          "type": "text",
          "labels": {
            "en": "Description"
          },
          "multiline": true
        }
      ],
      "help": {
        "en": "Something that could go wrong with a use case."
      },
      "shape": "shp_risk"
    }
  },
  "relations": {
    "rel_contributes": {
      "id": "rel_contributes",
      "key": "ContributesTo",
      "labels": {
        "en": "Contributes to"
      },
      "from": ["cls_usecase"],
      "to": ["cls_objective"],
      "attributes": [],
      "shape": "shp_contributes"
    },
    "rel_measured": {
      "id": "rel_measured",
      "key": "MeasuredBy",
      "labels": {
        "en": "Measured by"
      },
      "from": ["cls_usecase", "cls_objective"],
      "to": ["cls_kpi"],
      "attributes": [],
      "shape": "shp_measured"
    },
    "rel_sponsors": {
      "id": "rel_sponsors",
      "key": "Sponsors",
      "labels": {
        "en": "Sponsors"
      },
      "from": ["cls_stakeholder"],
      "to": ["cls_usecase"],
      "attributes": [],
      "shape": "shp_sponsors"
    },
    "rel_needsdata": {
      "id": "rel_needsdata",
      "key": "NeedsData",
      "labels": {
        "en": "Needs data"
      },
      "from": ["cls_usecase"],
      "to": ["cls_dataasset"],
      "attributes": [
        {
          "id": "att_ndcrit",
          "key": "Criticality",
          "type": "choice",
          "labels": {
            "en": "Criticality"
          },
          "options": ["Low", "Medium", "High"],
          "default": "Medium"
        }
      ],
      "shape": "shp_needsdata"
    },
    "rel_usestech": {
      "id": "rel_usestech",
      "key": "UsesTechnique",
      "labels": {
        "en": "Uses technique"
      },
      "from": ["cls_usecase"],
      "to": ["cls_technique"],
      "attributes": [],
      "shape": "shp_usestech"
    },
    "rel_hasrisk": {
      "id": "rel_hasrisk",
      "key": "HasRisk",
      "labels": {
        "en": "Has risk"
      },
      "from": ["cls_usecase"],
      "to": ["cls_risk"],
      "attributes": [],
      "shape": "shp_hasrisk"
    }
  },
  "modelTypes": {
    "mt_portfolio": {
      "id": "mt_portfolio",
      "key": "Portfolio",
      "labels": {
        "en": "Portfolio"
      },
      "classes": [
        "cls_usecase",
        "cls_objective",
        "cls_kpi",
        "cls_stakeholder",
        "cls_dataasset",
        "cls_technique",
        "cls_risk"
      ],
      "relations": [
        "rel_contributes",
        "rel_measured",
        "rel_sponsors",
        "rel_needsdata",
        "rel_usestech",
        "rel_hasrisk"
      ],
      "views": [
        {
          "id": "vw_value",
          "key": "Value",
          "labels": {
            "en": "Value"
          },
          "classes": [
            "cls_usecase",
            "cls_objective",
            "cls_kpi",
            "cls_stakeholder"
          ],
          "relations": ["rel_contributes", "rel_measured", "rel_sponsors"]
        },
        {
          "id": "vw_delivery",
          "key": "Delivery",
          "labels": {
            "en": "Delivery"
          },
          "classes": [
            "cls_usecase",
            "cls_dataasset",
            "cls_technique",
            "cls_risk"
          ],
          "relations": ["rel_needsdata", "rel_usestech", "rel_hasrisk"]
        }
      ],
      "cardinalities": [],
      "attributes": [
        {
          "id": "att_pftitle",
          "key": "Title",
          "type": "text",
          "labels": {
            "en": "Title"
          },
          "maxLength": 100
        },
        {
          "id": "att_pfowner",
          "key": "PortfolioOwner",
          "type": "text",
          "labels": {
            "en": "Portfolio owner"
          },
          "maxLength": 80
        },
        {
          "id": "att_pfperiod",
          "key": "Period",
          "type": "text",
          "labels": {
            "en": "Period"
          },
          "maxLength": 40
        }
      ],
      "help": {
        "en": "All use cases of a team or an area, with what they serve and need."
      }
    },
    "mt_canvas": {
      "id": "mt_canvas",
      "key": "UseCaseCanvas",
      "labels": {
        "en": "Use case canvas"
      },
      "classes": [
        "cls_usecase",
        "cls_objective",
        "cls_kpi",
        "cls_stakeholder",
        "cls_dataasset",
        "cls_technique",
        "cls_risk"
      ],
      "relations": [
        "rel_contributes",
        "rel_measured",
        "rel_sponsors",
        "rel_needsdata",
        "rel_usestech",
        "rel_hasrisk"
      ],
      "views": [],
      "cardinalities": [
        {
          "kind": "count",
          "class": "cls_usecase",
          "min": 1,
          "max": 1
        }
      ],
      "attributes": [
        {
          "id": "att_cvtitle",
          "key": "Title",
          "type": "text",
          "labels": {
            "en": "Title"
          },
          "maxLength": 100
        }
      ],
      "help": {
        "en": "One use case worked out in detail, with everything it links to."
      }
    }
  },
  "shapes": {
    "shp_usecase": {
      "id": "shp_usecase",
      "name": "Use case (coloured by quadrant)",
      "kind": "node",
      "size": {
        "width": 200,
        "height": 76,
        "resizable": true,
        "minWidth": 40,
        "minHeight": 28
      },
      "outline": "rect",
      "parts": [
        {
          "type": "rect",
          "x": 0,
          "y": 0,
          "width": "100%",
          "height": "100%",
          "radius": 4,
          "fill": "#ffffff",
          "stroke": "#495057",
          "strokeWidth": 1.5
        },
        {
          "type": "rect",
          "x": 0,
          "y": 0,
          "width": "100%",
          "height": 28,
          "radius": 4,
          "fill": "= Quadrant == 'Quick win' ? '#b2f2bb' : Quadrant == 'Strategic bet' ? '#a5d8ff' : Quadrant == 'Fill-in' ? '#ffec99' : Quadrant == 'Deprioritise' ? '#dee2e6' : '#f1f3f5'",
          "stroke": "#495057"
        },
        {
          "type": "text",
          "x": 8,
          "y": 2,
          "width": "100% - 36",
          "height": 24,
          "text": "= Name",
          "wrap": true,
          "fit": "shrink",
          "align": "center",
          "valign": "middle",
          "fill": "#1b1f27",
          "font": {
            "weight": 600
          }
        },
        {
          "type": "text",
          "x": 8,
          "y": 34,
          "width": "100% - 16",
          "height": 16,
          "text": "= 'PriorityScore: ' + PriorityScore",
          "wrap": true,
          "fit": "shrink",
          "align": "left",
          "valign": "middle",
          "fill": "#5a6373",
          "font": {
            "size": 11
          }
        },
        {
          "type": "text",
          "x": 8,
          "y": 50,
          "width": "100% - 16",
          "height": 16,
          "text": "= 'Status: ' + Status",
          "wrap": true,
          "fit": "shrink",
          "align": "left",
          "valign": "middle",
          "fill": "#5a6373",
          "font": {
            "size": 11
          }
        },
        {
          "type": "path",
          "d": "M12 3l2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1L3.2 9.5l6.1-.9z",
          "viewBox": [0, 0, 24, 24],
          "x": "100% - 26",
          "y": 4,
          "width": 20,
          "height": 20,
          "fill": "#00000000",
          "stroke": "#495057",
          "strokeWidth": 1.8
        },
        {
          "type": "rect",
          "x": "100% - 34",
          "y": -6,
          "width": 30,
          "height": 16,
          "radius": 8,
          "fill": "#e03131",
          "visible": "= RiskLevel == 'High'"
        },
        {
          "type": "text",
          "x": "100% - 34",
          "y": -6,
          "width": 30,
          "height": 16,
          "text": "Risk",
          "wrap": true,
          "fit": "shrink",
          "align": "center",
          "valign": "middle",
          "fill": "#ffffff",
          "font": {
            "size": 10,
            "weight": 600
          },

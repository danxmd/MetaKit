{
  "formatVersion": 6,
  "manifest": {
    "id": "tool_agentpipeline",
    "name": "Agent pipeline",
    "version": "1.0.0",
    "languages": ["en"]
  },
  "settings": {
    "grid": {
      "size": 10,
      "snap": true,
      "visible": true
    },
    "layers": [
      {
        "key": "main",
        "labels": {
          "en": "Main"
        },
        "visible": true
      }
    ],
    "numbering": {
      "enabled": false,
      "prefix": "",
      "start": 1
    }
  },
  "classes": {
    "cls_actor": {
      "id": "cls_actor",
      "key": "Actor",
      "kind": "node",
      "labels": {
        "en": "Actor"
      },
      "abstract": true,
      "attributes": [
        {
          "id": "att_actorname",
          "key": "Name",
          "type": "text",
          "labels": {
            "en": "Name"
          },
          "required": true,
          "maxLength": 80,
          "default": "New actor"
        },
        {
          "id": "att_actorrole",
          "key": "Role",
          "type": "text",
          "labels": {
            "en": "Role"
          },
          "maxLength": 120
        },
        {
          "id": "att_actornotes",
          "key": "Notes",
          "type": "text",
          "labels": {
            "en": "Notes"
          },
          "multiline": true
        }
      ],
      "help": {
        "en": "Anyone or anything that does work in the pipeline: an agent or a human."
      },
      "shape": "shp_agent"
    },
    "cls_agent": {
      "id": "cls_agent",
      "key": "Agent",
      "kind": "node",
      "labels": {
        "en": "Agent"
      },
      "extends": "cls_actor",
      "attributes": [
        {
          "id": "att_agentkind",
          "key": "AgentKind",
          "type": "choice",
          "labels": {
            "en": "Kind"
          },
          "options": ["LLM agent", "Script", "External tool"],
          "default": "LLM agent",
          "group": "Agent"
        },
        {
          "id": "att_autonomy",
          "key": "Autonomy",
          "type": "choice",
          "labels": {
            "en": "Autonomy"
          },
          "options": ["Suggest", "Approval", "Autonomous"],
          "default": "Approval",
          "group": "Agent"
        },
        {
          "id": "att_modelname",
          "key": "ModelName",
          "type": "text",
          "labels": {
            "en": "Model"
          },
          "group": "Agent",
          "maxLength": 80
        },
        {
          "id": "att_costlimit",
          "key": "CostLimit",
          "type": "number",
          "labels": {
            "en": "Cost limit per run"
          },
          "group": "Agent",
          "min": 0,
          "decimals": 2,
          "unit": "$"
        },
        {
          "id": "att_capabilities",
          "key": "Capabilities",
          "type": "table",
          "labels": {
            "en": "Capabilities"
          },
          "group": "Agent",
          "columns": [
            {
              "id": "capability",
              "key": "Capability",
              "type": "text"
            },
            {
              "id": "tool",
              "key": "Tool",
              "type": "text"
            }
          ],
          "maxRows": 30
        }
      ],
      "constraints": [
        {
          "id": "k_agent_limit",
          "formula": "Autonomy != 'Autonomous' || CostLimit != null",
          "message": "An autonomous agent should have a cost limit.",
          "severity": "warning"
        }
      ],
      "shape": "shp_agent"
    },
    "cls_human": {
      "id": "cls_human",
      "key": "Human",
      "kind": "node",
      "labels": {
        "en": "Human"
      },
      "extends": "cls_actor",
      "attributes": [
        {
          "id": "att_team",
          "key": "Team",
          "type": "text",
          "labels": {
            "en": "Team"
          },
          "group": "Person",
          "maxLength": 80,
          "default": ""
        },
        {
          "id": "att_availability",
          "key": "Availability",
          "type": "choice",
          "labels": {
            "en": "Availability"
          },
          "options": ["Available", "Busy", "Away"],
          "default": "Available",
          "group": "Person"
        }
      ],
      "shape": "shp_human"
    },
    "cls_task": {
      "id": "cls_task",
      "key": "Task",
      "kind": "node",
      "labels": {
        "en": "Task"
      },
      "attributes": [
        {
          "id": "att_taskname",
          "key": "Name",
          "type": "text",
          "labels": {
            "en": "Name"
          },
          "required": true,
          "maxLength": 100,
          "default": "New task"
        },
        {
          "id": "att_taskdesc",
          "key": "Description",
          "type": "text",
          "labels": {
            "en": "Description"
          },
          "multiline": true
        },
        {
          "id": "att_taskstatus",
          "key": "Status",
          "type": "choice",
          "labels": {
            "en": "Status"
          },
          "options": [
            "Planned",
            "Ready",
            "Running",
            "Waiting for human",
            "Done",
            "Failed"
          ],
          "default": "Planned"
        },
        {
          "id": "att_taskprio",
          "key": "Priority",
          "type": "choice",
          "labels": {
            "en": "Priority"
          },
          "options": ["Low", "Medium", "High"],
          "default": "Medium"
        },
        {
          "id": "att_effort",
          "key": "Effort",
          "type": "number",
          "labels": {
            "en": "Estimated effort"
          },
          "min": 0,
          "decimals": 1,
          "unit": "h",
          "group": "Effort"
        },
        {
          "id": "att_actual",
          "key": "ActualEffort",
          "type": "number",
          "labels": {
            "en": "Actual effort"
          },
          "min": 0,
          "decimals": 1,
          "unit": "h",
          "group": "Effort"
        },
        {
          "id": "att_variance",
          "key": "Variance",
          "type": "formula",
          "labels": {
            "en": "Variance"
          },
          "group": "Effort",
          "formula": "(ActualEffort ?? 0) - (Effort ?? 0)",
          "result": "number"
        },
        {
          "id": "att_taskcost",
          "key": "EstimatedCost",
          "type": "number",
          "labels": {
            "en": "Estimated cost"
          },
          "min": 0,
          "decimals": 2,
          "unit": "$",
          "group": "Effort"
        },
        {
          "id": "att_criteria",
          "key": "Criteria",
          "type": "text",
          "labels": {
            "en": "Acceptance criteria"
          },
          "multiline": true,
          "group": "Quality"
        },
        {
          "id": "att_checks",
          "key": "Checks",
          "type": "table",
          "labels": {
            "en": "Checks"
          },
          "group": "Quality",
          "columns": [
            {
              "id": "check",
              "key": "Check",
              "type": "text"
            },
            {
              "id": "passed",
              "key": "Passed",
              "type": "boolean"
            }
          ],
          "maxRows": 30
        }
      ],
      "constraints": [
        {
          "id": "k_done_actual",
          "formula": "Status != 'Done' || ActualEffort != null",
          "message": "A finished task should say how much effort it took.",
          "severity": "warning"
        },
        {
          "id": "k_failed_note",
          "formula": "Status != 'Failed' || Description != null",
          "message": "Say in the description why the task failed.",
          "severity": "warning"
        }
      ],
      "shape": "shp_task"
    },
    "cls_artifact": {
      "id": "cls_artifact",
      "key": "Artifact",
      "kind": "node",
      "labels": {
        "en": "Artifact"
      },
      "attributes": [
        {
          "id": "att_artname",
          "key": "Name",
          "type": "text",
          "labels": {
            "en": "Name"
          },
          "required": true,
          "maxLength": 100,
          "default": "New artifact"
        },
        {
          "id": "att_arttype",
          "key": "ArtifactType",
          "type": "choice",
          "labels": {
            "en": "Type"
          },
          "options": [
            "Document",
            "Code",
            "Dataset",
            "Report",
            "Decision",
            "Other"
          ],
          "default": "Document"
        },
        {
          "id": "att_artorigin",
          "key": "Origin",
          "type": "choice",
          "labels": {
            "en": "Origin"
          },
          "options": ["Produced", "Provided"],
          "default": "Produced"
        },
        {
          "id": "att_artstatus",
          "key": "Status",
          "type": "choice",
          "labels": {
            "en": "Status"
          },
          "options": ["Draft", "In review", "Approved", "Rejected"],
          "default": "Draft"
        },
        {
          "id": "att_artversion",
          "key": "Version",
          "type": "integer",
          "labels": {
            "en": "Version"
          },
          "min": 1,
          "default": 1
        },
        {
          "id": "att_approvedby",
          "key": "ApprovedBy",
          "type": "text",
          "labels": {
            "en": "Approved by"
          },
          "maxLength": 80
        },
        {
          "id": "att_artloc",
          "key": "Location",
          "type": "link",
          "labels": {
            "en": "Location"
          },
          "target": "any"
        },
        {
          "id": "att_artnotes",
          "key": "Notes",
          "type": "text",
          "labels": {
            "en": "Notes"
          },
          "multiline": true
        }
      ],
      "constraints": [
        {
          "id": "k_approved_by",
          "formula": "Status != 'Approved' || ApprovedBy != null",
          "message": "Say who approved this artifact.",
          "severity": "warning"
        }
      ],
      "shape": "shp_artifact"
    },
    "cls_gate": {
      "id": "cls_gate",
      "key": "Gate",
      "kind": "node",
      "labels": {
        "en": "Gate"
      },
      "attributes": [
        {
          "id": "att_gatename",
          "key": "Name",
          "type": "text",
          "labels": {
            "en": "Name"
          },
          "required": true,
          "maxLength": 80,
          "default": "Review"
        },
        {
          "id": "att_gatecriteria",
          "key": "Criteria",
          "type": "text",
          "labels": {
            "en": "Criteria"
          },
          "multiline": true
        },
        {
          "id": "att_decision",
          "key": "Decision",
          "type": "choice",
          "labels": {
            "en": "Decision"
          },
          "options": ["Pending", "Approved", "Rejected"],
          "default": "Pending"
        },
        {
          "id": "att_approver",
          "key": "Approver",
          "type": "text",
          "labels": {
            "en": "Approver"
          },
          "maxLength": 80
        }
      ],
      "help": {
        "en": "A point where a human decides before the pipeline goes on."
      },
      "shape": "shp_gate"
    },
    "cls_stage": {
      "id": "cls_stage",
      "key": "Stage",
      "kind": "swimlane",
      "labels": {
        "en": "Stage"
      },
      "attributes": [
        {
          "id": "att_stagename",
          "key": "StageName",
          "type": "text",
          "labels": {
            "en": "Name"
          },
          "required": true,
          "maxLength": 60,
          "default": "Stage"
        }
      ],
      "shape": "shp_stage"
    }
  },
  "relations": {
    "rel_performs": {
      "id": "rel_performs",
      "key": "Performs",
      "labels": {
        "en": "Performs"
      },
      "from": ["cls_actor"],
      "to": ["cls_task"],
      "attributes": [
        {
          "id": "att_perfrole",
          "key": "Role",
          "type": "choice",
          "labels": {
            "en": "Role"
          },
          "options": ["Responsible", "Reviewer", "Consulted"],
          "default": "Responsible"
        }
      ],
      "shape": "shp_performs"
    },
    "rel_handover": {
      "id": "rel_handover",
      "key": "HandsOverTo",
      "labels": {
        "en": "Hands over to"
      },
      "from": ["cls_task", "cls_gate"],
      "to": ["cls_task", "cls_gate"],
      "attributes": [
        {
          "id": "att_condition",
          "key": "Condition",
          "type": "text",
          "labels": {
            "en": "Condition"
          },
          "maxLength": 120
        },
        {
          "id": "att_handoff",
          "key": "Handoff",
          "type": "choice",
          "labels": {
            "en": "Handoff"
          },
          "options": ["Automatic", "Needs human"],
          "default": "Automatic"
        }
      ],
      "shape": "shp_handover"
    },
    "rel_produces": {
      "id": "rel_produces",
      "key": "Produces",
      "labels": {
        "en": "Produces"
      },
      "from": ["cls_task"],
      "to": ["cls_artifact"],
      "attributes": [],
      "shape": "shp_produces"
    },
    "rel_feeds": {
      "id": "rel_feeds",
      "key": "Feeds",
      "labels": {
        "en": "Feeds"
      },
      "from": ["cls_artifact"],
      "to": ["cls_task"],
      "attributes": [],
      "shape": "shp_feeds"
    },
    "rel_approves": {
      "id": "rel_approves",
      "key": "Approves",
      "labels": {
        "en": "Approves"
      },
      "from": ["cls_gate"],
      "to": ["cls_artifact"],
      "attributes": [],
      "shape": "shp_approves"
    },
    "rel_delegates": {
      "id": "rel_delegates",
      "key": "DelegatesTo",
      "labels": {
        "en": "Delegates to"
      },
      "from": ["cls_actor"],
      "to": ["cls_actor"],
      "attributes": [
        {
          "id": "att_scope",
          "key": "Scope",
          "type": "text",
          "labels": {
            "en": "Scope"
          },
          "maxLength": 120
        }
      ],
      "shape": "shp_delegates"
    }
  },
  "modelTypes": {
    "mt_pipeline": {
      "id": "mt_pipeline",
      "key": "Pipeline",
      "labels": {
        "en": "Pipeline"
      },
      "classes": [
        "cls_agent",
        "cls_human",
        "cls_task",
        "cls_artifact",
        "cls_gate",
        "cls_stage"
      ],
      "relations": [
        "rel_performs",
        "rel_handover",
        "rel_produces",
        "rel_feeds",
        "rel_approves",
        "rel_delegates"
      ],
      "views": [
        {
          "id": "vw_flow",
          "key": "Flow",
          "labels": {
            "en": "Flow"
          },
          "classes": ["cls_task", "cls_gate", "cls_stage"],
          "relations": ["rel_handover"]
        },
        {
          "id": "vw_people",
          "key": "Responsibilities",
          "labels": {
            "en": "Responsibilities"
          },
          "classes": ["cls_agent", "cls_human", "cls_task"],
          "relations": ["rel_performs", "rel_delegates"]
        }
      ],
      "cardinalities": [
        {
          "kind": "count",
          "class": "cls_task",
          "min": 1
        }
      ],
      "containers": {
        "cls_stage": [
          "cls_agent",
          "cls_human",
          "cls_task",
          "cls_gate",
          "cls_artifact"
        ]
      },
      "attributes": [
        {
          "id": "att_pltitle",
          "key": "Title",
          "type": "text",
          "required": true,
          "maxLength": 100
        },
        {
          "id": "att_plowner",
          "key": "PipelineOwner",
          "type": "text"
        },
        {
          "id": "att_plpurpose",
          "key": "Purpose",
          "type": "text",
          "multiline": true
        }
      ]
    },
    "mt_lineage": {
      "id": "mt_lineage",
      "key": "ArtifactLineage",
      "labels": {
        "en": "Artifact lineage"
      },
      "classes": ["cls_task", "cls_artifact", "cls_gate"],
      "relations": ["rel_produces", "rel_feeds", "rel_approves"],
      "views": [],
      "cardinalities": [],
      "attributes": [
        {
          "id": "att_ltitle",
          "key": "Title",
          "type": "text",
          "required": true,
          "maxLength": 100
        }
      ]
    }
  },
  "shapes": {
    "shp_agent": {
      "id": "shp_agent",
      "name": "Agent (bot)",
      "kind": "node",
      "size": {
        "width": 170,
        "height": 80,
        "resizable": true,
        "minWidth": 100,
        "minHeight": 50
      },
      "outline": "rect",
      "parts": [
        {
          "type": "rect",
          "x": 0,
          "y": 0,
          "width": "100%",
          "height": "100%",
          "radius": 12,
          "fill": "#dbe7ff",
          "stroke": "= if(Autonomy == 'Autonomous', '#e03131', if(Autonomy == 'Approval', '#f08c00', '#2f9e44'))",
          "strokeWidth": 3.5
        },
        {
          "type": "rect",
          "x": 8,
          "y": 8,
          "width": 22,
          "height": 16,
          "radius": 4,
          "fill": "#364fc7"
        },
        {
          "type": "ellipse",
          "x": 12,
          "y": 13,
          "width": 5,
          "height": 5,
          "fill": "#ffffff"
        },
        {
          "type": "ellipse",
          "x": 21,
          "y": 13,
          "width": 5,
          "height": 5,
          "fill": "#ffffff"
        },
        {
          "type": "rect",
          "x": 17,
          "y": 4,
          "width": 2,
          "height": 4,
          "fill": "#364fc7"
        },
        {
          "type": "text",
          "x": 36,
          "y": 6,
          "width": "100% - 44",
          "height": 18,
          "text": "= AgentKind",
          "font": {
            "size": 10,
            "weight": 600
          },
          "fill": "#364fc7",
          "align": "left",
          "valign": "middle"
        },
        {
          "type": "text",
          "x": 8,
          "y": 26,
          "width": "100% - 16",
          "height": "100% - 32",
          "text": "= $label",
          "wrap": true,
          "fit": "shrink",
          "align": "center",
          "valign": "middle"
        }
      ]
    },
    "shp_human": {
      "id": "shp_human",
      "name": "Human (person)",
      "kind": "node",
      "size": {
        "width": 170,
        "height": 80,
        "resizable": true,
        "minWidth": 100,
        "minHeight": 50
      },
      "outline": "rect",
      "parts": [
        {
          "type": "rect",
          "x": 0,
          "y": 0,
          "width": "100%",
          "height": "100%",
          "radius": 4,
          "fill": "#ffe8cc",
          "stroke": "#e8590c",
          "strokeWidth": 2
        },
        {
          "type": "ellipse",
          "x": 12,
          "y": 8,
          "width": 10,
          "height": 10,
          "fill": "#e8590c"
        },
        {
          "type": "path",
          "d": "M0 14 Q0 7 7 7 Q14 7 14 14 Z",
          "viewBox": [0, 0, 14, 14],
          "x": 10,
          "y": 18,
          "width": 14,
          "height": 10,
          "fill": "#e8590c"
        },
        {
          "type": "text",
          "x": 32,
          "y": 6,
          "width": "100% - 40",
          "height": 18,
          "text": "= Team",
          "font": {
            "size": 10,
            "weight": 600
          },
          "fill": "#e8590c",
          "align": "left",
          "valign": "middle"
        },
        {
          "type": "text",
          "x": 8,
          "y": 28,
          "width": "100% - 16",
          "height": "100% - 34",
          "text": "= $label",
          "wrap": true,
          "fit": "shrink",
          "align": "center",
          "valign": "middle"
        }
      ]
    },
    "shp_task": {
      "id": "shp_task",
      "name": "Task (status stripe)",
      "kind": "node",
      "size": {
        "width": 170,
        "height": 80,
        "resizable": true,
        "minWidth": 100,
        "minHeight": 50
      },
      "outline": "rect",
      "parts": [
        {
          "type": "rect",
          "x": 0,
          "y": 0,
          "width": "100%",
          "height": "100%",
          "radius": 8,
          "fill": "#ffffff",
          "stroke": "#495057",
          "strokeWidth": 1.5
        },
        {
          "type": "rect",
          "x": 0,
          "y": 0,
          "width": 10,
          "height": "100%",
          "radius": 8,
          "fill": "= if(Status == 'Done', '#d3f9d8', if(Status == 'Failed', '#ffe3e3', if(Status == 'Waiting for human', '#ffe8cc', if(Status == 'Running', '#d0ebff', if(Status == 'Ready', '#fff3bf', '#f1f3f5')))))",
          "stroke": "#495057",
          "strokeWidth": 1
        },
        {
          "type": "text",
          "x": 18,
          "y": 6,
          "width": "100% - 26",
          "height": "100% - 28",
          "text": "= $label",
          "wrap": true,
          "fit": "shrink",
          "align": "left",
          "valign": "middle"
        },
        {
          "type": "text",
          "x": 18,
          "y": "100% - 20",
          "width": "100% - 26",
          "height": 16,
          "text": "= Status + (Priority == 'High' ? ' · high' : '')",
          "font": {
            "size": 10
          },
          "fill": "#495057",
          "align": "left",
          "valign": "middle"
        }
      ]
    },
    "shp_artifact": {
      "id": "shp_artifact",
      "name": "Artifact (document)",
      "kind": "node",
      "size": {
        "width": 120,
        "height": 90,
        "resizable": true,
        "minWidth": 70,
        "minHeight": 50
      },
      "outline": "rect",
      "parts": [
        {
          "type": "polygon",
          "points": [
            [0, 0],
            ["100% - 16", 0],
            ["100%", 16],
            ["100%", "100%"],
            [0, "100%"]
          ],
          "fill": "= if(Status == 'Approved', '#d3f9d8', if(Status == 'In review', '#fff3bf', if(Status == 'Rejected', '#ffe3e3', '#f1f3f5')))",
          "stroke": "#495057",
          "strokeWidth": 1.5
        },
        {
          "type": "polygon",
          "points": [
            ["100% - 16", 0],
            ["100% - 16", 16],

{
  "formatVersion": 1,
  "manifest": {
    "id": "tool_bpmnlite",
    "name": "BPMN lite",
    "version": "1.0.0",
    "languages": ["en", "de"]
  },
  "settings": {
    "grid": { "size": 10, "snap": true, "visible": true },
    "layers": [
      {
        "key": "main",
        "labels": { "en": "Main", "de": "Haupt" },
        "visible": true
      }
    ],
    "numbering": { "enabled": true, "prefix": "T-", "start": 1 }
  },
  "classes": {
    "cls_flownode": {
      "id": "cls_flownode",
      "key": "FlowNode",
      "kind": "node",
      "labels": { "en": "Flow node", "de": "Flussknoten" },
      "abstract": true,
      "attributes": [
        {
          "id": "att_name",
          "key": "Name",
          "type": "text",
          "labels": { "en": "Name", "de": "Name" },
          "required": true,
          "maxLength": 80,
          "default": "New"
        },
        {
          "id": "att_description",
          "key": "Description",
          "type": "text",
          "labels": { "en": "Description", "de": "Beschreibung" },
          "multiline": true
        }
      ],
      "help": { "en": "Everything that can take part in a sequence flow." }
    },
    "cls_task": {
      "id": "cls_task",
      "key": "Task",
      "kind": "node",
      "labels": { "en": "Task", "de": "Aufgabe" },
      "extends": "cls_flownode",
      "attributes": [
        {
          "id": "att_priority",
          "key": "Priority",
          "type": "choice",
          "labels": { "en": "Priority", "de": "Priorität" },
          "options": ["Low", "Medium", "High"],
          "default": "Medium"
        },
        {
          "id": "att_owner",
          "key": "Owner",
          "type": "reference",
          "labels": { "en": "Owner", "de": "Verantwortlich" },
          "target": { "modelTypes": ["mt_process"], "classes": ["cls_lane"] },
          "max": 1
        },
        {
          "id": "att_effort",
          "key": "Effort",
          "type": "number",
          "labels": { "en": "Effort", "de": "Aufwand" },
          "min": 0,
          "decimals": 1,
          "unit": "h"
        },
        {
          "id": "att_cost",
          "key": "Cost",
          "type": "formula",
          "labels": { "en": "Cost", "de": "Kosten" },
          "formula": "Effort * 85",
          "result": "number"
        },
        {
          "id": "att_due",
          "key": "Due",
          "type": "date",
          "labels": { "en": "Due date", "de": "Fällig am" }
        },
        {
          "id": "att_duration",
          "key": "Duration",
          "type": "duration",
          "labels": { "en": "Duration", "de": "Dauer" },
          "default": "PT1H"
        },
        {
          "id": "att_tags",
          "key": "Tags",
          "type": "multi-choice",
          "options": ["Finance", "Legal", "Customer"],
          "max": 3
        },
        {
          "id": "att_checklist",
          "key": "Checklist",
          "type": "table",
          "columns": [
            { "id": "item", "key": "Item", "type": "text" },
            { "id": "done", "key": "Done", "type": "boolean" }
          ],
          "maxRows": 20
        },
        { "id": "att_spec", "key": "Spec", "type": "link", "target": "any" },
        {
          "id": "att_open",
          "key": "OpenSpec",
          "type": "action",
          "labels": { "en": "Open specification" },
          "run": { "kind": "command", "ref": "openSpec" }
        }
      ]
    },
    "cls_gateway": {
      "id": "cls_gateway",
      "key": "Gateway",
      "kind": "node",
      "labels": { "en": "Gateway", "de": "Gateway" },
      "extends": "cls_flownode",
      "attributes": [
        {
          "id": "att_gatewaykind",
          "key": "GatewayKind",
          "type": "choice",
          "options": ["XOR", "AND", "OR"],
          "default": "XOR"
        }
      ]
    },
    "cls_start": {
      "id": "cls_start",
      "key": "StartEvent",
      "kind": "node",
      "labels": { "en": "Start event", "de": "Startereignis" },
      "extends": "cls_flownode",
      "attributes": []
    },
    "cls_end": {
      "id": "cls_end",
      "key": "EndEvent",
      "kind": "node",
      "labels": { "en": "End event", "de": "Endereignis" },
      "extends": "cls_flownode",
      "attributes": []
    },
    "cls_lane": {
      "id": "cls_lane",
      "key": "Lane",
      "kind": "swimlane",
      "labels": { "en": "Lane", "de": "Bahn" },
      "attributes": [
        {
          "id": "att_lanename",
          "key": "LaneName",
          "type": "text",
          "labels": { "en": "Name", "de": "Name" },
          "required": true,
          "maxLength": 60
        }
      ]
    }
  },
  "relations": {
    "rel_flow": {
      "id": "rel_flow",
      "key": "SequenceFlow",
      "labels": { "en": "Sequence flow", "de": "Sequenzfluss" },
      "from": ["cls_flownode"],
      "to": ["cls_flownode"],
      "attributes": [
        {
          "id": "att_condition",
          "key": "Condition",
          "type": "text",
          "labels": { "en": "Condition", "de": "Bedingung" },
          "maxLength": 120
        }
      ]
    }
  },
  "modelTypes": {
    "mt_process": {
      "id": "mt_process",
      "key": "Process",
      "labels": { "en": "Process", "de": "Prozess" },
      "classes": [
        "cls_task",
        "cls_gateway",
        "cls_start",
        "cls_end",
        "cls_lane"
      ],
      "relations": ["rel_flow"],
      "views": [
        {
          "id": "vw_flowonly",
          "key": "FlowOnly",
          "labels": { "en": "Flow only", "de": "Nur Fluss" },
          "classes": ["cls_task", "cls_gateway", "cls_start", "cls_end"],
          "relations": ["rel_flow"]
        }
      ],
      "cardinalities": [
        { "kind": "count", "class": "cls_start", "min": 1, "max": 1 },
        { "kind": "count", "class": "cls_end", "min": 1 },
        {
          "kind": "degree",
          "class": "cls_start",
          "relation": "rel_flow",
          "end": "to",
          "max": 0
        },
        {
          "kind": "degree",
          "class": "cls_end",
          "relation": "rel_flow",
          "end": "from",
          "max": 0
        }
      ],
      "attributes": [
        {
          "id": "att_title",
          "key": "Title",
          "type": "text",
          "required": true,
          "maxLength": 100
        },
        {
          "id": "att_version",
          "key": "Version",
          "type": "integer",
          "min": 1,
          "default": 1
        },
        { "id": "att_processowner", "key": "ProcessOwner", "type": "text" }
      ]
    }
  }
}

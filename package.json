{
  "name": "metakit",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @metakit-app/web dev",
    "typecheck": "tsc -b && tsc -p apps/cli --noEmit && tsc -p bench --noEmit && tsc -p spikes/canvas --noEmit && tsc -p spikes/sync --noEmit && tsc -p spikes/behaviour --noEmit && tsc -p spikes/git --noEmit && pnpm --filter @metakit-app/web typecheck",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "pnpm -r --if-present test:e2e",
    "bench": "pnpm --filter @metakit-app/bench bench",
    "bench:spike": "pnpm --filter @metakit-app/spike-canvas bench",
    "build": "pnpm --filter @metakit-app/web build && pnpm --filter @metakit-app/cli build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
